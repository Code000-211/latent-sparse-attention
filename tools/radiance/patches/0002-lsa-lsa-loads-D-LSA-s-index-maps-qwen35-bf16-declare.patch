diff --git a/abi/rad_builder.h b/abi/rad_builder.h
index 08ae1c6..70ebcc7 100644
--- a/abi/rad_builder.h
+++ b/abi/rad_builder.h
@@ -295,8 +295,41 @@ typedef struct RadBuildCtx {
      * fixed buffers ignores them, and the core says so at startup. */
     int64_t  gen_max_pixels;
     int64_t  gen_max_refs;
+
+    /* ---- appended in ABI 33 (D-LSA) */
+    /* --lsa MAP: D-LSA's index maps and the flat design's sizes (RadLsaMap below), or null. Null,
+     * the zero-initialised default, declares nothing of it. The engine sets it only for a plugin
+     * whose probe sets RadArchProbe::lsa_ok and refuses the flag otherwise. */
+    const struct RadLsaMap* lsa;
 } RadBuildCtx;
 
+/* ================================================================== D-LSA */
+/* Latent sparse attention (Prefrontal-AI, arXiv 2610.42147): a full-attention query reads its
+ * sinks, its window and the `top_k` keys of the `top_p` buckets its index query scores best,
+ * instead of its whole history. The buckets come from clustering each `window`-key block of index
+ * keys once, when it closes (libref/ref_lsa.h states the algorithm; docs/OPS.md `lsa_*` the ops).
+ *
+ * The map is the published `d-lsa-weights-v1` form, a torch zip of `{L}.W_Q_idx` and `{L}.W_K_idx`
+ * for each full-attention layer L, [key_dim, index_dim] f32, key_dim being every KV head's dims
+ * past its rotated prefix side by side. The engine loads it once at bringup (core/lsa.h) and gives
+ * each rank its device copy in bf16, one [2][key_dim][index_dim] block a map, W_Q first; the
+ * sizes are the flags' (--lsa-window and the rest), checked to nest as the design requires. */
+typedef struct RadLsaMap {
+    const void*    maps;           /* device, [n_maps][2][key_dim][index_dim] bf16 */
+    const int32_t* map_of_layer;   /* host, [n_layers]: model layer l's map, or -1 for none */
+    int64_t        n_layers;
+    int64_t        n_maps;
+    int64_t        key_dim;
+    int64_t        index_dim;
+    int64_t        window;         /* recent keys always read, and a cluster block's keys */
+    int64_t        sink;           /* first keys always read */
+    int64_t        top_k;          /* long-range keys read */
+    int64_t        top_p;          /* buckets a query picks */
+    int64_t        pool;           /* consecutive keys clustered as one */
+    int64_t        bucket;         /* average keys a bucket */
+    int64_t        bucket_cap;     /* most keys a bucket */
+} RadLsaMap;
+
 /* ================================================================== control vectors */
 /* A direction per layer, in the shape llama.cpp's `--cvec-mode project` applies it:
  *
@@ -1605,6 +1638,11 @@ typedef struct RadArchProbe {
      * gen_patches answer for them. */
     int64_t gen_max_pixels;
     int64_t gen_max_refs;
+
+    /* ---- appended in ABI 33 (D-LSA) */
+    /* Nonzero when the plugin declares D-LSA's index side for this model under RadBuildCtx::lsa.
+     * 64-bit so it starts past the older struct's tail padding. */
+    int64_t lsa_ok;
 } RadArchProbe;
 
 int rad_arch_probe(const RadModelMeta* meta, RadArchProbe* out);
