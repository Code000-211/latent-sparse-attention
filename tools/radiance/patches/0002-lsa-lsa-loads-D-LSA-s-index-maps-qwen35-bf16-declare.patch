+++ b/core/lsa.cpp
@@ -0,0 +1,197 @@
+/* lsa.cpp -- reading and checking D-LSA's index maps (core/lsa.h). The reader is
+ * core/format/torch_zip.cpp, which maps the archive and interprets its pickle as data. */
+#include "lsa.h"
+
+#include "format/torch_zip.h"
+#include "rad_core.h"
+
+#include <array>
+#include <cstring>
+#include <map>
+
+namespace rad {
+
+namespace {
+
+/* `{L}.W_Q_idx` or `{L}.W_K_idx`: the layer and the side (0 query, 1 key), or false. */
+bool parse_name(const std::string& n, int64_t* layer, int* side) {
+    const size_t dot = n.find('.');
+    if (dot == 0 || dot == std::string::npos || dot > 9) return false;
+    for (size_t i = 0; i < dot; ++i)
+        if (n[i] < '0' || n[i] > '9') return false;
+    const std::string rest = n.substr(dot + 1);
+    if (rest == "W_Q_idx") *side = 0;
+    else if (rest == "W_K_idx") *side = 1;
+    else return false;
+    *layer = std::stoll(n.substr(0, dot));
+    return true;
+}
+
+uint16_t bf16_of(float f) {
+    uint32_t u;
+    std::memcpy(&u, &f, 4);
+    if ((u & 0x7fffffffu) > 0x7f800000u) return (uint16_t) ((u >> 16) | 0x40u);
+    u += 0x7fffu + ((u >> 16) & 1u);
+    return (uint16_t) (u >> 16);
+}
+
+}  /* namespace */
+
+const char* lsa_sizes_refusal(int64_t window, int64_t sink, int64_t top_k, int64_t top_p,
+                              int64_t pool, int64_t bucket, int64_t bucket_cap) {
+    if (window < 1 || sink < 0 || top_k < 1 || top_p < 1 || pool < 1 || bucket < 1 || bucket_cap < 1)
+        return "every size must be positive (the sinks may be 0)";
+    if (bucket % pool || bucket_cap % pool)
+        return "--lsa-pool must divide --lsa-bucket and --lsa-bucket-cap";
+    if (window % bucket) return "--lsa-bucket must divide --lsa-window, the keys a block clusters";
+    if (bucket_cap < 2 * bucket)
+        return "--lsa-bucket-cap must be at least twice --lsa-bucket, or Ward can stop short of a "
+               "block's bucket count";
+    if (top_p * bucket_cap < top_k)
+        return "--lsa-top-p buckets of --lsa-bucket-cap keys cannot fill --lsa-top-k";
+    return nullptr;
+}
+
+int lsa_map_load(const std::string& path, int64_t n_model_layers, const Config& cfg, LsaMap* out,
+                 std::string* err) {
+    if (!out || !err) return RAD_E_INVAL;
+    *out = LsaMap{};
+    if (const char* why = lsa_sizes_refusal(cfg.lsa_window, cfg.lsa_sink, cfg.lsa_top_k,
+                                            cfg.lsa_top_p, cfg.lsa_pool, cfg.lsa_bucket,
+                                            cfg.lsa_bucket_cap)) {
+        *err = why;
+        return RAD_E_INVAL;
+    }
+    TorchZipFile f;
+    std::string why;
+    const int rc = f.open(path, &why);
+    if (rc != RAD_OK) {
+        *err = "not a readable torch zip: " + why;
+        return rc;
+    }
+    /* layer -> its two tensors */
+    std::map<int64_t, std::array<const TorchTensor*, 2>> by_layer;
+    for (const TorchTensor& t : f.tensors()) {
+        int64_t layer = 0;
+        int side = 0;
+        if (!parse_name(t.name, &layer, &side)) {
+            *err = "'" + t.name + "' is not a map's name: an index map is {L}.W_Q_idx and "
+                   "{L}.W_K_idx for each full-attention layer L";
+            return RAD_E_INVAL;
+        }
+        if (layer >= n_model_layers) {
+            *err = "'" + t.name + "' names layer " + std::to_string(layer) + ", and the model has " +
+                   std::to_string(n_model_layers);
+            return RAD_E_INVAL;
+        }
+        if (t.dtype != RAD_F32 && t.dtype != RAD_BF16) {
+            *err = "'" + t.name + "' is " + t.storage + "; a map is f32 or bf16";
+            return RAD_E_DTYPE;
+        }
+        if (t.shape.size() != 2 || t.shape[0] < 1 || t.shape[1] < 1) {
+            *err = "'" + t.name + "' is not a [key_dim, index_dim] matrix";
+            return RAD_E_SHAPE;
+        }
+        if (out->key_dim == 0) {
+            out->key_dim = t.shape[0];
+            out->index_dim = t.shape[1];
+        } else if (t.shape[0] != out->key_dim || t.shape[1] != out->index_dim) {
+            *err = "'" + t.name + "' is [" + std::to_string(t.shape[0]) + ", " +
+                   std::to_string(t.shape[1]) + "] and the first map [" +
+                   std::to_string(out->key_dim) + ", " + std::to_string(out->index_dim) +
+                   "]: every map has one shape";
+            return RAD_E_SHAPE;
+        }
+        auto& slot = by_layer[layer];
+        if (slot[side]) {
+            *err = "'" + t.name + "' appears twice";
+            return RAD_E_INVAL;
+        }
+        slot[side] = &t;
+    }
+    if (by_layer.empty()) {
+        *err = "the file holds no map";
+        return RAD_E_INVAL;
+    }
+    const int64_t per = out->key_dim * out->index_dim;
+    out->n_layers = n_model_layers;
+    out->map_of_layer.assign((size_t) n_model_layers, -1);
+    out->maps.resize((size_t) (by_layer.size() * 2 * per));
+    for (const auto& [layer, pair] : by_layer) {
+        for (int side = 0; side < 2; ++side)
+            if (!pair[side]) {
+                *err = "layer " + std::to_string(layer) + " has " +
+                       (side ? "no W_K_idx" : "no W_Q_idx") + "; a layer needs both maps";
+                return RAD_E_INVAL;
+            }
+        const int64_t m = out->n_maps();
+        out->map_of_layer[(size_t) layer] = (int32_t) m;
+        out->layers.push_back((int32_t) layer);
+        for (int side = 0; side < 2; ++side) {
+            const TorchTensor& t = *pair[side];
+            uint16_t* dst = &out->maps[(size_t) ((m * 2 + side) * per)];
+            if (t.dtype == RAD_BF16) {
+                std::memcpy(dst, t.data, (size_t) per * 2);
+            } else {
+                for (int64_t i = 0; i < per; ++i) {
+                    float v;
+                    std::memcpy(&v, t.data + i * 4, 4);
+                    dst[i] = bf16_of(v);
+                }
+            }
+        }
+    }
+    out->window = cfg.lsa_window;
+    out->sink = cfg.lsa_sink;
+    out->top_k = cfg.lsa_top_k;
+    out->top_p = cfg.lsa_top_p;
+    out->pool = cfg.lsa_pool;
+    out->bucket = cfg.lsa_bucket;
+    out->bucket_cap = cfg.lsa_bucket_cap;
+    out->path = path;
+    return RAD_OK;
+}
+
+const void* lsa_map_upload(const LsaMap& m, int rank) {
+    if (!m.loaded()) return nullptr;
+    void* d = rad_dev_alloc(m.bytes(), RAD_MEM_DEVICE);
+    if (!d) {
+        RAD_ERR("--lsa: rank %d: could not allocate %.2f MiB on the card for the index maps", rank,
+                (double) m.bytes() / (1024.0 * 1024.0));
+        return nullptr;
+    }
+    RadStream s = nullptr;
+    if (rad_stream_create(&s, 0) < 0) {
+        rad_dev_free(d, RAD_MEM_DEVICE);
+        return nullptr;
+    }
+    const int rc = rad_memcpy_async(d, m.maps.data(), m.bytes(), s);
+    rad_stream_sync(s);
+    rad_stream_destroy(s);
+    if (rc < 0) {
+        RAD_ERR("--lsa: rank %d: uploading the index maps failed: %s", rank, rad_dev_last_error());
+        rad_dev_free(d, RAD_MEM_DEVICE);
+        return nullptr;
+    }
+    return d;
+}
+
+RadLsaMap lsa_map_view(const LsaMap& m, const void* maps_device) {
+    RadLsaMap v{};
+    v.maps = maps_device;
+    v.map_of_layer = m.map_of_layer.data();
+    v.n_layers = m.n_layers;
+    v.n_maps = m.n_maps();
+    v.key_dim = m.key_dim;
+    v.index_dim = m.index_dim;
+    v.window = m.window;
+    v.sink = m.sink;
+    v.top_k = m.top_k;
+    v.top_p = m.top_p;
+    v.pool = m.pool;
+    v.bucket = m.bucket;
+    v.bucket_cap = m.bucket_cap;
+    return v;
+}
+
+}  /* namespace rad */
