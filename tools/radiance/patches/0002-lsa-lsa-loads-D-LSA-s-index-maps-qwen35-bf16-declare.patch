+/* --lsa (RadBuildCtx::lsa, arch/common/rad_block_lsa.h): each full-attention layer declares D-LSA's
+ * index side -- two groups for the model, three ops a layer -- and attends its decode rows over
+ * their lists where a library declares `attn_paged_list`; a prefill stores and clusters but attends
+ * densely. A map of another model's shape and a deployment of two ranks are refused. Without the
+ * flag the graph is the one pinned in with_every_op_declared_each_architecture_declares_its_
+ * unchanged_graph. */
+TEST(qwen35_bf16_lsa_declares_the_index_side) {
+    RadModelMeta meta = qwen35_meta();
+    std::vector<uint16_t> maps(2 * 2 * 768 * 64);
+    std::vector<int32_t> mol(8, -1);
+    mol[3] = 0;
+    mol[7] = 1;
+    RadLsaMap lm{};
+    lm.maps = maps.data(); lm.map_of_layer = mol.data(); lm.n_layers = 8; lm.n_maps = 2;
+    lm.key_dim = 768; lm.index_dim = 64; lm.window = 512; lm.sink = 4; lm.top_k = 4096;
+    lm.top_p = 1024; lm.pool = 4; lm.bucket = 8; lm.bucket_cap = 16;
+    RadBuildCtx ctx = build_ctx();
+    ctx.lsa = &lm;
+
+    RadBuilder b;
+    CHECK_OK(qwen35_bf16::declare(&b, &meta, &ctx));
+    for (const char* op : { "lsa_index_store", "lsa_cluster", "lsa_select", "attn_paged_list" })
+        CHECK_EQ(count_op(b, op), 2);
+    CHECK_EQ(count_op(b, "attn_paged"), 2);   /* the prefill half's */
+    const RecKV* idx = nullptr;
+    const RecKV* bkt = nullptr;
+    for (const auto& k : b.kv_groups) {
+        if (k.name == "kv_lsa_idx") idx = &k;
+        if (k.name == "kv_lsa_bkt") bkt = &k;
+    }
+    REQUIRE(idx && bkt);
+    /* A token's index key is one bf16 row of 64 over the manager's K and V halves; a block's
+     * buckets are 64 of (64 + 16) * 2 bytes over its 512 tokens' halves. */
+    CHECK_EQ(idx->d.dtype, (uint32_t)RAD_BF16);
+    CHECK_EQ(idx->d.head_dim * 2, (int64_t)64);
+    CHECK_EQ(bkt->d.dtype, (uint32_t)RAD_U8);
+    CHECK_EQ(2 * 512 * bkt->d.head_dim, (int64_t)(64 * (64 + 16) * 2));
+    CHECK(idx->dense && bkt->dense);
+    int bound = 0;
+    for (const auto& [l, g] : b.binds)
+        if (g == (rad_kvgroup)(idx - b.kv_groups.data() + 1) || g == (rad_kvgroup)(bkt - b.kv_groups.data() + 1)) {
+            CHECK(l == 3 || l == 7);
+            ++bound;
+        }
+    CHECK_EQ(bound, 4);
+    for (const auto& o : b.ops)
+        if (o.op == "lsa_cluster") CHECK_EQ(pint(&o, "block_size"), 512);
+
+    /* A decode step attends over the lists; a prefill step keeps the dense attention. */
+    RadBatch batch = decode_batch();
+    RadCtx c{ .b = &b, .batch = &batch };
+    qwen35_bf16::step(&c, &batch);
+    CHECK_LINT(b, &c);
+    std::vector<std::string> ops = issued_ops(b, c);
+    CHECK_EQ(std::count(ops.begin(), ops.end(), "lsa_select"), 2);
+    CHECK_EQ(std::count(ops.begin(), ops.end(), "attn_paged_list"), 2);
+    CHECK_EQ(std::count(ops.begin(), ops.end(), "attn_paged"), 0);
+    {
+        const auto at = [&](const char* op) { return std::find(ops.begin(), ops.end(), op) - ops.begin(); };
+        CHECK(at("kv_store") < at("lsa_index_store"));
+        CHECK(at("lsa_index_store") < at("lsa_cluster"));
+        CHECK(at("lsa_cluster") < at("lsa_select"));
+        CHECK(at("lsa_select") < at("attn_paged_list"));
+    }
+    RadBatch pre = prefill_batch();
+    RadCtx cp{ .b = &b, .batch = &pre };
+    qwen35_bf16::step(&cp, &pre);
+    CHECK_LINT(b, &cp);
+    ops = issued_ops(b, cp);
+    CHECK_EQ(std::count(ops.begin(), ops.end(), "lsa_index_store"), 2);
+    CHECK_EQ(std::count(ops.begin(), ops.end(), "lsa_cluster"), 2);
+    CHECK_EQ(std::count(ops.begin(), ops.end(), "lsa_select"), 0);
+    CHECK_EQ(std::count(ops.begin(), ops.end(), "attn_paged"), 2);
+
+    /* With no library declaring the list attention the index side is kept, the attention dense. */
+    RadBuilder nb;
+    nb.undeclared.insert("attn_paged_list");
+    CHECK_OK(qwen35_bf16::declare(&nb, &meta, &ctx));
+    CHECK_EQ(count_op(nb, "attn_paged_list"), 0);
+    CHECK_EQ(count_op(nb, "lsa_cluster"), 2);
+    RadBatch dec = decode_batch();
+    RadCtx cn{ .b = &nb, .batch = &dec };
+    qwen35_bf16::step(&cn, &dec);
+    ops = issued_ops(nb, cn);
+    CHECK_EQ(std::count(ops.begin(), ops.end(), "lsa_select"), 0);
+    CHECK_EQ(std::count(ops.begin(), ops.end(), "attn_paged"), 2);
+
+    lm.key_dim = 512;
+    RadBuilder bad;
+    CHECK_EQ(stderr_of_rc([&] { return qwen35_bf16::declare(&bad, &meta, &ctx); }), RAD_E_SHAPE);
+    lm.key_dim = 768;
+    RadBuildCtx two = build_ctx(0, 2);
+    two.lsa = &lm;
+    RadBuilder tp;
+    CHECK_EQ(stderr_of_rc([&] { return qwen35_bf16::declare(&tp, &meta, &two); }), RAD_E_UNSUPPORTED);
+}
