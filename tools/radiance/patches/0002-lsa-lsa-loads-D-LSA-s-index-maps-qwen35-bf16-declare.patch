diff --git a/arch/common/rad_block_lsa.h b/arch/common/rad_block_lsa.h
new file mode 100644
index 0000000..47a7962
--- /dev/null
+++ b/arch/common/rad_block_lsa.h
@@ -0,0 +1,207 @@
+/* rad_block_lsa.h -- D-LSA's index side for a full-attention block: index keys, closed-block
+ * clustering and the decode rows' key lists.
+ *
+ *   rope -> kv_store -> lsa_index_store -> lsa_cluster -> lsa_select (decode rows) -> attention
+ *
+ * D-LSA (latent sparse attention, Prefrontal-AI, arXiv 2610.42147, Apache-2.0) lets a decode query
+ * read its sinks, its window and the `top_k` keys of the `top_p` buckets its index query scores
+ * best, instead of its whole history (abi/rad_builder.h RadLsaMap; libref/ref_lsa.h states the
+ * algorithm, libr4d/r4d_lsa.hip runs it). It is off unless the deployment gives --lsa
+ * (RadBuildCtx::lsa); off, a block declares none of this, so its graph and bytes are unchanged.
+ *
+ * Two KV groups beside the attention's, declared by the first layer that asks, since a group's
+ * block size comes from the op declared to read it (spec §7.2):
+ *
+ *   kv_lsa_idx  a token's index key, bf16 [64], paged like the attention's cache. The block manager
+ *               pages a K and a V half, so the group is declared at head_dim 32: the operand is
+ *               [blocks, 1, block, 64], one row a token. `lsa_index_store` reads it.
+ *   kv_lsa_bkt  a closed block's buckets, one page a cluster block (`window` tokens): centroids
+ *               then members, (64 + cap) * 2 bytes a bucket, declared as bytes. `lsa_cluster`
+ *               writes it; `lsa_select` reads it.
+ *
+ * Both are read over the whole history (a block is clustered from the keys of the block just
+ * closed, and every decode row scores every closed block), so neither streams
+ * (rad_kv_group_dense_read). Both are cached and restored with the attention's pages: a closed
+ * block's buckets are a function of its tokens, as its KV is. The bucket group's `window`-token
+ * page makes the step's chunk quantum a multiple of the window (core/sched/geometry.cpp).
+ *
+ * The lists are the decode rows' only: a prefill chunk stores its index keys and closes its blocks
+ * but attends densely (block-sparse prefill is the paper's second phase). A sequence's rows close
+ * every block whose last key they write, so a rejected draft's rewrite of that key clusters the
+ * block again when it is written next.
+ *
+ * Under tensor parallelism an index key sums every KV head and an index query every query head of
+ * the layer, so each rank holds a partial projection; the all_reduce that would join them is not
+ * declared yet, and a deployment above one rank is refused. */
+#ifndef RAD_BLOCK_LSA_H
+#define RAD_BLOCK_LSA_H
+
+#include "rad_arch.h"
+
+namespace rad {
+namespace arch {
+
+/* Declared once by the plugin and shared by every full-attention layer: the map, the two groups
+ * (the first layer's declare fills them in) and the activation buffers. */
+struct LsaShared {
+    const RadLsaMap* map = nullptr;
+    rad_kvgroup idx = 0, bkt = 0;
+    rad_buf iq = 0;       /* [max_tok, 64] f32 index queries */
+    rad_buf score = 0;    /* [rows, live_max] f32 bucket scores */
+    rad_buf sel = 0;      /* [rows, width] i32 key positions, ascending, -1 padded */
+    rad_buf nsel = 0;     /* [rows] i32 */
+    int64_t rows = 0;     /* the decode rows one step may carry */
+    int64_t live_max = 0; /* the buckets of a context of max_ctx */
+    int64_t width = 0;    /* sink + top_k + window: the contract's S_max */
+    int64_t nb = 0;       /* buckets a cluster block */
+    int64_t page_hd = 0;  /* kv_lsa_bkt's declared head_dim, in bytes: a page is 2 * window * this */
+
+    int declare(RadBuilder* b, Names& nm, const Geom& g, int64_t n_rot, const RadLsaMap* m) {
+        map = m;
+        const int64_t free = g.head_dim - n_rot;
+        if (g.world > 1) {
+            fprintf(stderr, "radiance: --lsa: D-LSA's index key sums every KV head and its query "
+                            "every query head of a layer; at %d ranks each holds a partial "
+                            "projection, and the all_reduce that joins them is not declared yet. "
+                            "Serve it at one rank.\n", g.world);
+            return RAD_E_UNSUPPORTED;
+        }
+        if (m->index_dim != 64 || m->key_dim != g.n_head_kv * free || g.n_head % g.n_head_kv) {
+            fprintf(stderr, "radiance: --lsa: the maps are [%lld, %lld]; this model's index input "
+                            "is %lld KV heads of %lld position-free dims (%lld), into 64 index "
+                            "dims\n", (long long)m->key_dim, (long long)m->index_dim,
+                    (long long)g.n_head_kv, (long long)free, (long long)(g.n_head_kv * free));
+            return RAD_E_SHAPE;
+        }
+        nb = m->window / m->bucket;
+        /* A page is nb * (64 + cap) * 2 bytes, which the manager sizes as 2 * window * head_dim. */
+        if ((nb * (64 + m->bucket_cap) * 2) % (2 * m->window)) {
+            fprintf(stderr, "radiance: --lsa: a cluster block's buckets are %lld bytes, which is no "
+                            "whole number of bytes a token of its %lld-token page\n",
+                    (long long)(nb * (64 + m->bucket_cap) * 2), (long long)m->window);
+            return RAD_E_SHAPE;
+        }
+        page_hd = nb * (64 + m->bucket_cap) * 2 / (2 * m->window);
+        rows = g.max_seqs * (1 + (g.max_spec > 0 ? g.max_spec : 0));
+        live_max = (g.max_ctx + m->window - 1) / m->window * nb;
+        width = m->sink + m->top_k + m->window;
+        iq    = decl_b(b, nm.f("lsa_iq"),    RAD_F32, {g.max_tok, 64});
+        score = decl_b(b, nm.f("lsa_score"), RAD_F32, {rows, live_max});
+        sel   = decl_b(b, nm.f("lsa_sel"),   RAD_I32, {rows, width});
+        nsel  = decl_b(b, nm.f("lsa_nsel"),  RAD_I32, {rows});
+        return iq && score && sel && nsel ? RAD_OK : RAD_E_INVAL;
+    }
+};
+
+/* One full-attention layer's index side. */
+struct LsaIndex {
+    Geom             g{};
+    int              layer = 0;
+    int64_t          n_rot = 0;
+    const LsaShared* sh = nullptr;
+    const void*      map = nullptr;   /* this layer's [2][key_dim][64] bf16, W_Q first, on the card */
+    rad_op op_store = 0, op_cluster = 0, op_select = 0;
+
+    /* After the attention's own ops (its group's block size is read here). `q` and `k` are the
+     * block's normed and rotated query and key rows. */
+    int declare(RadBuilder* b, Names& nm, const Geom& geom, int l, int64_t rotary_dim,
+                rad_kvgroup attn_kv, LsaShared* s, rad_buf q, rad_buf k) {
+        g = geom; layer = l; n_rot = rotary_dim; sh = s;
+        const RadLsaMap* m = s->map;
+        if (l < 0 || l >= m->n_layers || m->map_of_layer[l] < 0) {
+            fprintf(stderr, "radiance: --lsa: the maps have none for full-attention layer %d\n", l);
+            return RAD_E_INVAL;
+        }
+        map = (const uint8_t*)m->maps + (size_t)m->map_of_layer[l] * 2 * m->key_dim * 64 * 2;
+        const int64_t bs = rad_kv_block_size(b, attn_kv);
+
+        /* The index keys are paged like the attention's cache. */
+        if (!s->idx) {
+            RadKVGroupDecl d{};
+            d.kind = RAD_KV_FULL;
+            d.dtype = RAD_BF16;
+            d.n_head_kv = 1;
+            d.head_dim = 32;   /* K and V halves: one 64-wide row a token */
+            s->idx = rad_decl_kv_group(b, nm.f("kv_lsa_idx"), &d);
+            RAD_ARCH_TRY(rad_kv_group_dense_read(b, s->idx));
+        }
+        op_store = rw(b, RAD_OP(b, "lsa_index_store",
+                          RAD_PARAMS(RAD_RANGE("M", 1, g.max_tok), RAD_INT("head_dim", g.head_dim),
+                                     RAD_INT("n_head", g.n_head), RAD_INT("n_head_kv", g.n_head_kv),
+                                     RAD_INT("rot", n_rot), RAD_INT("dim", 64),
+                                     RAD_INT("block_size", bs)),
+                          RAD_NOWEIGHTS),
+                      {q, k}, {s->iq});
+        if (!op_store || rad_kv_block_size(b, s->idx) != bs) return RAD_E_INVAL;
+        RAD_ARCH_TRY(rad_bind_layer_kv(b, l, s->idx));
+
+        /* A closed block's buckets, a page a block. */
+        if (!s->bkt) {
+            RadKVGroupDecl d{};
+            d.kind = RAD_KV_FULL;
+            d.dtype = RAD_U8;
+            d.n_head_kv = 1;
+            d.head_dim = s->page_hd;
+            s->bkt = rad_decl_kv_group(b, nm.f("kv_lsa_bkt"), &d);
+            RAD_ARCH_TRY(rad_kv_group_dense_read(b, s->bkt));
+        }
+        op_cluster = rw(b, RAD_OP(b, "lsa_cluster",
+                            RAD_PARAMS(RAD_RANGE("M", 1, g.max_tok), RAD_INT("window", m->window),
+                                       RAD_INT("pool", m->pool), RAD_INT("bucket", m->bucket),
+                                       RAD_INT("cap", m->bucket_cap), RAD_INT("dim", 64),
+                                       RAD_INT("block_size", m->window)),
+                            RAD_NOWEIGHTS),
+                        {}, {});
+        /* Its page is `window` tokens, from `block_size` above; lsa_cluster refuses any other by
+         * name at launch. */
+        if (!op_cluster) return RAD_E_INVAL;
+        RAD_ARCH_TRY(rad_bind_layer_kv(b, l, s->bkt));
+
+        op_select = rw(b, RAD_OP(b, "lsa_select",
+                           RAD_PARAMS(RAD_RANGE("M", 1, s->rows), RAD_INT("window", m->window),
+                                      RAD_INT("sink", m->sink), RAD_INT("top_k", m->top_k),
+                                      RAD_INT("top_p", m->top_p), RAD_INT("pool", m->pool),
+                                      RAD_INT("bucket", m->bucket), RAD_INT("cap", m->bucket_cap),
+                                      RAD_INT("dim", 64)),
+                           RAD_NOWEIGHTS),
+                       {s->iq}, {s->score, s->sel, s->nsel});
+        return op_select ? RAD_OK : RAD_E_INVAL;
+    }
+
+    /* Every row's index key and query, from the normed and rotated q and k, and every block the
+     * step's rows close. After kv_store. */
+    void store(RadCtx* c, const RadBatch* batch, rad_buf q, rad_buf k) const {
+        const RadKVGroupBatch* ib = kv_batch(batch, sh->idx);
+        const RadKVGroupBatch* bb = kv_batch(batch, sh->bkt);
+        const int64_t T = batch->n_tok, S = batch->n_seq;
+        RAD_ISSUE(c, op_store, brows(q, T), brows(k, T),
+                  praw2(map, RAD_BF16, 2 * sh->map->key_dim, 64),
+                  praw(ib ? ib->slot_mapping : nullptr, RAD_I32, T), kv_cache(sh->idx, layer),
+                  brows(sh->iq, T));
+        RAD_ISSUE(c, op_cluster, praw(batch->positions, RAD_I32, T),
+                  praw(batch->cu_seqlens, RAD_I32, S + 1), kv_cache(sh->idx, layer),
+                  praw2(ib ? ib->block_table : nullptr, RAD_I32, S, ib ? ib->block_table_pitch : 0),
+                  kv_cache(sh->bkt, layer),
+                  praw2(bb ? bb->block_table : nullptr, RAD_I32, S, bb ? bb->block_table_pitch : 0));
+    }
+
+    /* The decode rows' lists (sequences [0, D), rows [0, DT)) into sh->sel and sh->nsel. The score
+     * plane is viewed at the step's context bound, which the pass key holds (a recorded decode
+     * pass replays it until the bound crosses a bucket). */
+    void select(RadCtx* c, const RadBatch* batch, int64_t D, int64_t DT) const {
+        const RadKVGroupBatch* bb = kv_batch(batch, sh->bkt);
+        const RadLsaMap* m = sh->map;
+        int64_t live = ((int64_t)batch->max_ctx_len + batch->max_q_len) / m->window * sh->nb;
+        if (live > sh->live_max) live = sh->live_max;
+        if (live < 1) live = 1;
+        RAD_ISSUE_N(c, op_select, DT, brows(sh->iq, DT), praw(batch->positions, RAD_I32, DT),
+                    praw(batch->cu_seqlens, RAD_I32, D + 1), kv_cache(sh->bkt, layer),
+                    praw2(bb ? bb->block_table : nullptr, RAD_I32, D, bb ? bb->block_table_pitch : 0),
+                    bcol(sh->score, 0, live, DT), brows(sh->sel, DT), brows(sh->nsel, DT));
+    }
+};
+
+}  /* namespace arch */
+}  /* namespace rad */
