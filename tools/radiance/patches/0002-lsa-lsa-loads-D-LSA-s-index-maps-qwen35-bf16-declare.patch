+++ b/core/lsa.h
@@ -0,0 +1,59 @@
+/* lsa.h -- D-LSA's index maps: the --lsa sidecar read, checked and handed to each rank.
+ *
+ * D-LSA (latent sparse attention, Prefrontal-AI, arXiv 2610.42147, Apache-2.0) gives each key of a
+ * full-attention layer a 64-dim index key, its position-free dims through a learned map, and has a
+ * decode query read the keys of the buckets its index query scores best (abi/rad_builder.h
+ * RadLsaMap; libref/ref_lsa.h for the algorithm). The maps ship as the paper's `d-lsa-weights-v1`
+ * files: a torch zip (torch.save of a state dict) of `{L}.W_Q_idx` and `{L}.W_K_idx` for each
+ * full-attention layer L, [key_dim, index_dim] f32 -- on Qwen3.8-27B sixteen layers of [768, 64],
+ * 768 being its four KV heads' 192 dims past the rotated 64.
+ *
+ * The file is read without running its pickle (format/torch_zip.h). It is refused unless every
+ * entry is one of those two names for a layer inside the model, every layer has both, and every
+ * map has one shape. Whether the shape fits the model's heads is the plugin's question, which it
+ * answers at declare. The sizes (--lsa-window and the rest) must nest as the design requires:
+ * pool divides bucket and cap, bucket divides window, cap is at least twice bucket, and top_p
+ * buckets of cap keys can fill top_k.
+ *
+ * The maps are kept in bf16, the form the plugin's projection reads (the SGLang plugin rounds them
+ * so too), one [2][key_dim][index_dim] block a map, W_Q first, and each rank gets its own device
+ * copy outside the program's arena, as a control vector's is. */
+#pragma once
+#include "rad_internal.h"
+
+#include <string>
+#include <vector>
+
+namespace rad {
+
+struct Config;
+
+struct LsaMap {
+    std::vector<uint16_t> maps;           /* [n_maps][2][key_dim][index_dim] bf16 */
+    std::vector<int32_t>  map_of_layer;   /* [n_layers]: the map of model layer l, or -1 */
+    std::vector<int32_t>  layers;         /* the mapped layers, ascending */
+    int64_t n_layers = 0, key_dim = 0, index_dim = 0;
+    int64_t window = 0, sink = 0, top_k = 0, top_p = 0, pool = 0, bucket = 0, bucket_cap = 0;
+    std::string path;
+
+    bool    loaded() const { return !maps.empty(); }
+    int64_t n_maps() const { return (int64_t) layers.size(); }
+    int64_t bytes() const { return (int64_t) maps.size() * 2; }
+};
+
+/* Null when the sizes nest as the design requires, else why not. */
+const char* lsa_sizes_refusal(int64_t window, int64_t sink, int64_t top_k, int64_t top_p,
+                              int64_t pool, int64_t bucket, int64_t bucket_cap);
+
+/* Read and check `path` against a model of `n_model_layers`, with the sizes `cfg` gives. */
+int lsa_map_load(const std::string& path, int64_t n_model_layers, const Config& cfg, LsaMap* out,
+                 std::string* err);
+
+/* Upload the maps to a fresh device buffer on the current device, or null on failure. The caller
+ * frees it with rad_dev_free(RAD_MEM_DEVICE). */
+const void* lsa_map_upload(const LsaMap& m, int rank);
+
+/* The ABI view for one rank over its device copy. */
+RadLsaMap lsa_map_view(const LsaMap& m, const void* maps_device);
+
+}  /* namespace rad */
