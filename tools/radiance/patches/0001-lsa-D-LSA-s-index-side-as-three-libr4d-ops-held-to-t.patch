+/* tests/r4d_emu: D-LSA's index side (r4d_lsa.hip) on the host SIMT emulator: the index key store,
+ * the closed-block clustering and the decode selection over tests/lsa_cases.h's fixtures, each held
+ * to libref/ref_lsa.h byte for byte. The card runs the same fixtures (tests/lsa_device_test.cpp)
+ * at the design's full budget; here the design-sized select runs at a smaller top_k and top_p, which
+ * reach the same paths, so the run stays in seconds. */
+#include "rad_abi.h"
+#include "lsa_cases.h"
+
+#include <cstdio>
+#include <cstring>
+
+extern "C" int r4d_rad_lsa_index_store(const RadArgs*, RadStream);
+extern "C" int r4d_rad_lsa_cluster(const RadArgs*, RadStream);
+extern "C" int r4d_rad_lsa_select(const RadArgs*, RadStream);
+
+int main() {
+    lsa_cases::Tally tl;
+    const lsa_cases::Backend host = [](const char* sym, std::vector<lsa_cases::Opd>& t,
+                                       const std::vector<RadParam>& p) {
+        const lsa_cases::Launch fn = !std::strcmp(sym, "r4d_rad_lsa_index_store") ? r4d_rad_lsa_index_store
+                                   : !std::strcmp(sym, "r4d_rad_lsa_cluster")     ? r4d_rad_lsa_cluster
+                                                                                   : r4d_rad_lsa_select;
+        std::vector<RadTensor> ts;
+        for (const lsa_cases::Opd& o : t) ts.push_back(lsa_cases::tensor_of(o, o.data));
+        RadArgs a{};
+        a.t = ts.data();
+        a.n_t = (int)ts.size();
+        a.p = p.data();
+        a.n_p = (int)p.size();
+        return fn(&a, nullptr);
+    };
+    lsa_cases::run_all(host, tl, false);
+    std::printf("r4d_emu lsa: %d of %d checks passed\n", tl.cases - tl.failed, tl.cases);
+    return tl.failed ? 1 : 0;
+}
