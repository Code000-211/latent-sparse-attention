+/* lsa_cases.h -- D-LSA's index-side ops (libr4d/r4d_lsa.hip) on fixtures, against libref/ref_lsa.h bit
+ * for bit. Shared by the host emulator (tests/r4d_emu/test_lsa.cpp) and the card
+ * (tests/lsa_device_test.cpp), which differ only in where a launch's tensors live: a Backend runs
+ * one entry point, by its symbol, over host tensors and returns with every tensor's host copy
+ * updated.
+ *
+ * The fixtures put the pages where a block manager would, through scrambled tables, and carry
+ * the rows a step does: decode rows, a verify's run, a prefill chunk across two block boundaries,
+ * rows before the first closed block and rows on a boundary. The select's cases reach both of the
+ * pick kernel's paths (every visible bucket a candidate, and the radix select) and its tie path
+ * (more buckets at the top_p-th score than it takes), by giving buckets identical centroids.
+ *
+ * Every case is checked exactly: the kernels fix ref_lsa.h's orders (its header). Pages a step must
+ * not write keep a sentinel. */
+#pragma once
+
+#include "rad_abi.h"
+#include "ref_lsa.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <numeric>
+#include <random>
+#include <string>
+#include <vector>
+
+namespace lsa_cases {
+
+using Launch = int (*)(const RadArgs*, RadStream);
+
+/* One operand over a host vector. */
+struct Opd {
+    void* data = nullptr;
+    size_t bytes = 0;
+    uint32_t dtype = RAD_DT_INVALID;
+    std::vector<int64_t> shape;
+};
+template <class T>
+Opd opd(std::vector<T>& v, uint32_t dt, std::vector<int64_t> shape) {
+    return Opd{ v.data(), v.size() * sizeof(T), dt, std::move(shape) };
+}
+
+/* Runs the entry point `symbol` over the operands (their host bytes in, every operand's bytes back
+ * out). */
+using Backend = std::function<int(const char* symbol, std::vector<Opd>& t,
+                                  const std::vector<RadParam>& p)>;
+
+inline RadTensor tensor_of(const Opd& o, void* data) {
+    RadTensor t{};
+    t.data = data;
+    t.dtype = o.dtype;
+    t.rank = (uint32_t)o.shape.size();
+    for (size_t i = 0; i < o.shape.size(); ++i) t.shape[i] = o.shape[i];
+    rad_tensor_pack(&t);
+    return t;
+}
+inline RadParam pint(const char* k, long long v) {
+    RadParam p{};
+    p.key = k;
+    p.kind = RAD_P_INT;
+    p.ival = v;
+    return p;
+}
+
+struct Tally {
+    int cases = 0, failed = 0;
+    bool verbose = std::getenv("LSA_VERBOSE") != nullptr;
+    void check(bool ok, const std::string& what) {
+        ++cases;
+        if (verbose) std::fprintf(stderr, "%s %s\n", ok ? "ok  " : "FAIL", what.c_str());
+        if (!ok) {
+            ++failed;
+            std::fprintf(stderr, "FAIL %s\n", what.c_str());
+        }
+    }
+};
+
+inline uint16_t bf(float f) { return rad_lsa::f32_bf16(f); }
+
+/* Keys that come in runs near one of a few directions, as text's do, unit and bf16. */
+inline std::vector<uint16_t> structured_keys(std::mt19937_64& rng, int64_t n, int64_t dim) {
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    std::vector<std::vector<float>> centers(16, std::vector<float>((size_t)dim));
+    for (auto& c : centers) for (auto& x : c) x = nd(rng);
+    std::vector<uint16_t> out((size_t)(n * dim));
+    int64_t c = 0, run = 0;
+    for (int64_t t = 0; t < n; ++t) {
+        if (run == 0) { c = (int64_t)(rng() % 16); run = 1 + (int64_t)(rng() % 30); }
+        --run;
+        std::vector<float> v((size_t)dim);
+        float s = 0.0f;
+        for (int64_t d = 0; d < dim; ++d) { v[(size_t)d] = centers[(size_t)c][(size_t)d] + 0.5f * nd(rng); s += v[(size_t)d] * v[(size_t)d]; }
+        s = std::sqrt(s);
+        for (int64_t d = 0; d < dim; ++d) out[(size_t)(t * dim + d)] = bf(v[(size_t)d] / s);
+    }
+    return out;
+}
+
+/* ================================================================== lsa_index_store */
+inline void index_store(const Backend& run, Tally& tl, int64_t T, int64_t n_head, int64_t n_kv,
+                        int64_t hd, int64_t rot, uint64_t seed) {
+    std::mt19937_64 rng(seed);
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    const int64_t D = 64, free = hd - rot, key_dim = n_kv * free, blocks = (T + 15) / 16 + 3;
+    const int64_t q_ld = n_head * hd + 8;   /* a pitch wider than the heads */
+    std::vector<uint16_t> q((size_t)(T * q_ld)), k((size_t)(T * n_kv * hd)), map((size_t)(2 * key_dim * D));
+    for (auto& x : q) x = bf(nd(rng));
+    for (auto& x : k) x = bf(nd(rng));
+    for (auto& x : map) x = bf(0.05f * nd(rng));
+    std::vector<int32_t> slots((size_t)(blocks * 16));
+    std::iota(slots.begin(), slots.end(), 0);
+    std::shuffle(slots.begin(), slots.end(), rng);
+    std::vector<int32_t> slot((size_t)T);
+    for (int64_t r = 0; r < T; ++r) slot[(size_t)r] = r % 7 == 3 ? -1 : slots[(size_t)r];
+    std::vector<uint16_t> cache((size_t)(blocks * 16 * D), 0x7fc1), want = cache;
+    std::vector<float> iq((size_t)(T * D), -7.0f), want_iq = iq;
+    for (int64_t r = 0; r < T; ++r) {
+        /* The query heads at the row's pitch, packed for the oracle. */
+        std::vector<uint16_t> qr(q.begin() + r * q_ld, q.begin() + r * q_ld + n_head * hd);
+        rad_lsa::index_query(qr.data(), n_head, n_kv, hd, rot, map.data(), D, &want_iq[(size_t)(r * D)]);
+        if (slot[(size_t)r] >= 0)
+            rad_lsa::index_key(&k[(size_t)(r * n_kv * hd)], n_kv, hd, rot, map.data() + key_dim * D, D,
+                               &want[(size_t)slot[(size_t)r] * D]);
+    }
+    /* The query rows are wider than the heads, as a fused projection's are. */
+    std::vector<Opd> t = { opd(q, RAD_BF16, { T, q_ld }), opd(k, RAD_BF16, { T, n_kv * hd }),
+                           opd(map, RAD_BF16, { 2 * key_dim, D }), opd(slot, RAD_I32, { T }),
+                           opd(cache, RAD_BF16, { blocks, 1, 16, D }), opd(iq, RAD_F32, { T, D }) };
+    std::vector<RadParam> p = { pint("head_dim", hd), pint("n_head", n_head), pint("n_head_kv", n_kv),
+                                pint("rot", rot), pint("dim", D), pint("block_size", 16) };
+    const int rc = run("r4d_rad_lsa_index_store", t, p);
+    char what[160];
+    std::snprintf(what, sizeof what, "lsa_index_store T=%lld heads %lld/%lld hd %lld rot %lld",
+                  (long long)T, (long long)n_head, (long long)n_kv, (long long)hd, (long long)rot);
+    tl.check(rc == RAD_OK, std::string(what) + ": status");
+    tl.check(cache == want, std::string(what) + ": the stored index keys");
+    tl.check(std::memcmp(iq.data(), want_iq.data(), iq.size() * 4) == 0, std::string(what) + ": the index queries");
+}
+
+/* ================================================================== pools and tables */
+/* A paged group over `n_seq` sequences of `ctx` tokens at `block` a page, the pages scrambled. */
+struct Paged {
+    int64_t block = 0, cols = 0, pages = 0;
+    std::vector<int32_t> bt;   /* [n_seq][cols] */
+    Paged(std::mt19937_64& rng, int64_t n_seq, int64_t ctx, int64_t blk, int64_t spare)
+        : block(blk), cols((ctx + blk - 1) / blk) {
+        pages = n_seq * cols + spare;
+        std::vector<int32_t> ids((size_t)pages);
+        std::iota(ids.begin(), ids.end(), 0);
+        std::shuffle(ids.begin(), ids.end(), rng);
+        bt.assign(ids.begin(), ids.begin() + n_seq * cols);
+    }
+    int32_t page(int64_t s, int64_t pos) const { return bt[(size_t)(s * cols + pos / block)]; }
+};
+
+inline std::vector<RadParam> geom_params(const rad_lsa::Geom& g) {
+    return { pint("window", g.window), pint("sink", g.sink), pint("top_k", g.top_k),
+             pint("top_p", g.top_p), pint("pool", g.pool), pint("bucket", g.bucket),
+             pint("cap", g.cap), pint("dim", g.dim), pint("block_size", g.window) };
+}
+
+/* ================================================================== lsa_cluster */
+/* Each sequence's step rows run [first, last]; every block whose last key lies among them is
+ * clustered from the keys stored so far. */
+inline void cluster(const Backend& run, Tally& tl, const rad_lsa::Geom& g,
+                    const std::vector<std::pair<int64_t, int64_t>>& rows, int64_t ctx, uint64_t seed) {
+    std::mt19937_64 rng(seed);
+    const int64_t n_seq = (int64_t)rows.size(), D = g.dim, PB = g.page_bytes();
+    Paged ip(rng, n_seq, ctx, 16, 5), bp(rng, n_seq, ctx, g.window, 3);
+    std::vector<uint16_t> idx((size_t)(ip.pages * 16 * D), 0x7fc1);
+    std::vector<std::vector<uint16_t>> keys;
+    for (int64_t s = 0; s < n_seq; ++s) {
+        keys.push_back(structured_keys(rng, ctx, D));
+        for (int64_t t = 0; t <= rows[(size_t)s].second; ++t)
+            std::memcpy(&idx[(size_t)((ip.page(s, t) * 16 + t % 16) * D)], &keys.back()[(size_t)(t * D)], (size_t)D * 2);
+    }
+    std::vector<uint8_t> bkt((size_t)(bp.pages * PB), 0xa5), want = bkt;
+    std::vector<int32_t> pos, cu = { 0 };
+    int64_t closed = 0;
+    for (int64_t s = 0; s < n_seq; ++s) {
+        const auto [a, b] = rows[(size_t)s];
+        for (int64_t p = a; p <= b; ++p) pos.push_back((int32_t)p);
+        cu.push_back((int32_t)pos.size());
+        for (int64_t blk = a / g.window; blk < (b + 1) / g.window; ++blk, ++closed)
+            rad_lsa::cluster_block(&keys[(size_t)s][(size_t)(blk * g.window * D)], g,
+                                   &want[(size_t)(bp.bt[(size_t)(s * bp.cols + blk)] * PB)]);
+    }
+    const int64_t T = (int64_t)pos.size();
+    std::vector<Opd> t = { opd(pos, RAD_I32, { T }), opd(cu, RAD_I32, { n_seq + 1 }),
+                           opd(idx, RAD_BF16, { ip.pages, 1, 16, D }), opd(ip.bt, RAD_I32, { n_seq, ip.cols }),
+                           opd(bkt, RAD_U8, { bp.pages, 1, g.window, PB / g.window }),
+                           opd(bp.bt, RAD_I32, { n_seq, bp.cols }) };
+    const int rc = run("r4d_rad_lsa_cluster", t, geom_params(g));
+    char what[160];
+    std::snprintf(what, sizeof what, "lsa_cluster window %lld, %lld sequences, %lld rows, %lld blocks closing",
+                  (long long)g.window, (long long)n_seq, (long long)T, (long long)closed);
+    tl.check(rc == RAD_OK, std::string(what) + ": status");
+    int64_t bad = 0;
+    for (int64_t pg = 0; pg < bp.pages; ++pg)
+        bad += std::memcmp(&bkt[(size_t)(pg * PB)], &want[(size_t)(pg * PB)], (size_t)PB) != 0;
+    if (bad) std::fprintf(stderr, "  %lld of %lld pages differ\n", (long long)bad, (long long)bp.pages);
+    tl.check(bad == 0, std::string(what) + ": every page (the closed blocks', and the rest untouched)");
+}
+
+/* ================================================================== lsa_select */
+/* `rows`: (sequence, position) a query row, the rows of a sequence consecutive. `ctx` keys a
+ * sequence, so blocks [0, ctx / window) are closed. `dup` gives that many buckets of each sequence
+ * one centroid, for ties. */
+inline void select(const Backend& run, Tally& tl, const rad_lsa::Geom& g, int64_t n_seq, int64_t ctx,
+                   const std::vector<std::pair<int64_t, int64_t>>& rows, int64_t dup, uint64_t seed) {
+    std::mt19937_64 rng(seed);
+    const int64_t D = g.dim, PB = g.page_bytes(), NB = g.buckets(), blocks = ctx / g.window;
+    Paged bp(rng, n_seq, ctx, g.window, 2);
+    std::vector<uint8_t> bkt((size_t)(bp.pages * PB), 0);
+    for (int64_t s = 0; s < n_seq; ++s) {
+        const std::vector<uint16_t> keys = structured_keys(rng, blocks * g.window, D);
+        for (int64_t b = 0; b < blocks; ++b)
+            rad_lsa::cluster_block(&keys[(size_t)(b * g.window * D)], g, &bkt[(size_t)(bp.bt[(size_t)(s * bp.cols + b)] * PB)]);
+        /* `dup` buckets spread over the sequence take bucket 0's centroid. */
+        const uint8_t* c0 = &bkt[(size_t)(bp.bt[(size_t)(s * bp.cols)] * PB)];
+        for (int64_t i = 1; i <= dup && blocks > 0; ++i) {
+            const int64_t b = (i * 7919) % (blocks * NB);
+            std::memcpy(&bkt[(size_t)(bp.bt[(size_t)(s * bp.cols + b / NB)] * PB + (b % NB) * D * 2)], c0, (size_t)D * 2);
+        }
+    }
+    const int64_t M = (int64_t)rows.size(), W = g.width() + 5;   /* a wider row than it must be */
+    std::vector<float> iq((size_t)(M * D));
+    std::vector<int32_t> pos((size_t)M), cu((size_t)n_seq + 1, 0);
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    for (int64_t m = 0; m < M; ++m) {
+        pos[(size_t)m] = (int32_t)rows[(size_t)m].second;
+        cu[(size_t)rows[(size_t)m].first + 1] = (int32_t)(m + 1);
+        const int64_t s = rows[(size_t)m].first;
+        /* A query near bucket 0's centroid for the tie cases, else a random direction. */
+        float n2 = 0.0f;
+        const uint16_t* c0 = (const uint16_t*)&bkt[(size_t)(bp.bt[(size_t)(s * bp.cols)] * PB)];
+        for (int64_t d = 0; d < D; ++d) {
+            const float v = dup ? rad_lsa::bf16_f32(c0[d]) + 0.05f * nd(rng) : nd(rng);
+            iq[(size_t)(m * D + d)] = v;
+            n2 += v * v;
+        }
+        for (int64_t d = 0; d < D; ++d) iq[(size_t)(m * D + d)] /= std::sqrt(n2);
+    }
+    for (int64_t s = 1; s <= n_seq; ++s) cu[(size_t)s] = std::max(cu[(size_t)s], cu[(size_t)s - 1]);
+    /* The score plane at the closed blocks' buckets, one column spare. */
+    const int64_t live = blocks * NB + 1;
+    std::vector<float> score((size_t)(M * live), 0.0f);
+    std::vector<int32_t> sel((size_t)(M * W), 0x55555555), nsel((size_t)M, -9);
+    std::vector<int32_t> want((size_t)(M * W), -1), want_n((size_t)M);
+    for (int64_t m = 0; m < M; ++m) {
+        const int64_t s = rows[(size_t)m].first;
+        std::vector<const uint8_t*> pl;
+        for (int64_t b = 0; b < blocks; ++b) pl.push_back(&bkt[(size_t)(bp.bt[(size_t)(s * bp.cols + b)] * PB)]);
+        want_n[(size_t)m] = (int32_t)rad_lsa::read_row(&iq[(size_t)(m * D)], pos[(size_t)m], pl.data(),
+                                                       (int64_t)pl.size(), g, &want[(size_t)(m * W)]);
+    }
+    std::vector<Opd> t = { opd(iq, RAD_F32, { M, D }), opd(pos, RAD_I32, { M }), opd(cu, RAD_I32, { n_seq + 1 }),
+                           opd(bkt, RAD_U8, { bp.pages, 1, g.window, PB / g.window }),
+                           opd(bp.bt, RAD_I32, { n_seq, bp.cols }), opd(score, RAD_F32, { M, live }),
+                           opd(sel, RAD_I32, { M, W }), opd(nsel, RAD_I32, { M }) };
+    const int rc = run("r4d_rad_lsa_select", t, geom_params(g));
+    char what[200];
+    std::snprintf(what, sizeof what, "lsa_select window %lld top_k %lld top_p %lld, %lld rows over %lld "
+                  "buckets a sequence%s", (long long)g.window, (long long)g.top_k, (long long)g.top_p,
+                  (long long)M, (long long)(blocks * NB), dup ? ", with ties" : "");
+    tl.check(rc == RAD_OK, std::string(what) + ": status");
+    int64_t bad = 0;
+    for (int64_t m = 0; m < M; ++m) {
+        const bool ok = nsel[(size_t)m] == want_n[(size_t)m] &&
+                        std::memcmp(&sel[(size_t)(m * W)], &want[(size_t)(m * W)], (size_t)W * 4) == 0;
+        if (!ok && bad < 4)
+            std::fprintf(stderr, "  row %lld (position %d): %d keys, want %d\n", (long long)m,
+                         pos[(size_t)m], nsel[(size_t)m], want_n[(size_t)m]);
+        bad += !ok;
+    }
+    tl.check(bad == 0, std::string(what) + ": every row's list and length");
+}
+
+/* ================================================================== the set */
+inline void run_all(const Backend& run, Tally& tl, bool large) {
+    index_store(run, tl, 37, 24, 4, 256, 64, 1);   /* Qwen3.5/3.8's attention */
+    index_store(run, tl, 5, 8, 2, 128, 32, 2);
+    rad_lsa::Geom small;
+    small.window = 64; small.top_k = 96; small.top_p = 24;
+    rad_lsa::Geom design;   /* the flat design's own sizes */
+    /* A decode row closing a block, one that closes none, a prefill chunk across two boundaries, a
+     * verify run ending on one, and a row on a block's first key. */
+    cluster(run, tl, small, { { 64 * 3 + 63, 64 * 3 + 63 }, { 200, 200 }, { 10, 150 }, { 509, 511 }, { 256, 256 } },
+            640, 3);
+    cluster(run, tl, design, { { 512 * 3 + 511, 512 * 3 + 511 }, { 1000, 1000 }, { 100, 1300 } }, 2048, 4);
+    /* Rows before any closed block, on a boundary, past it, and deep; every bucket a candidate
+     * (small: 40 blocks of 8 over top_p 24 is the radix path; the 2-block sequence's rows the
+     * other). */
+    select(run, tl, small, 3, 64 * 40,
+           { { 0, 5 }, { 0, 63 }, { 0, 64 }, { 0, 127 }, { 0, 64 * 40 - 1 }, { 1, 64 * 3 + 7 },
+             { 1, 64 * 20 }, { 1, 64 * 20 + 1 }, { 1, 64 * 20 + 2 }, { 2, 64 * 39 + 63 } }, 0, 5);
+    select(run, tl, small, 2, 64 * 30, { { 0, 64 * 29 + 3 }, { 0, 64 * 30 - 1 }, { 1, 64 * 25 } }, 30, 6);
+    select(run, tl, small, 1, 64 * 2, { { 0, 64 * 2 - 1 }, { 0, 64 + 1 } }, 0, 7);
+    if (large) {
+        select(run, tl, design, 2, 512 * 24,
+               { { 0, 512 * 24 - 1 }, { 0, 512 * 9 + 100 }, { 1, 512 * 23 }, { 1, 512 * 23 + 1 } }, 0, 8);
+        select(run, tl, design, 1, 512 * 20, { { 0, 512 * 20 - 1 } }, 1100, 9);
+    } else {
+        rad_lsa::Geom mid = design;   /* the design's block, a smaller budget */
+        mid.top_k = 512; mid.top_p = 96;
+        select(run, tl, mid, 2, 512 * 8, { { 0, 512 * 8 - 1 }, { 1, 512 * 5 + 17 } }, 0, 8);
+        select(run, tl, mid, 1, 512 * 6, { { 0, 512 * 6 - 1 } }, 120, 9);
+    }
+}
+
