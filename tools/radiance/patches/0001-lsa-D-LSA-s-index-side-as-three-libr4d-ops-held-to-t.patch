diff --git a/tests/lsa_ref_test.cpp b/tests/lsa_ref_test.cpp
new file mode 100644
index 0000000..6e218b6
--- /dev/null
+++ b/tests/lsa_ref_test.cpp
@@ -0,0 +1,306 @@
+/* lsa_ref_test.cpp -- D-LSA's host selector (libref/ref_lsa.h) against the paper's torch reference.
+ *
+ * ref_lsa.h is the oracle libr4d's kernels are held to (tests/r4d_emu/test_lsa.cpp,
+ * tests/lsa_device_test.cpp), so it is held here to the reference itself, src/lsa/core/reference.py
+ * of Prefrontal-AI/latent-sparse-attention: the same buckets out of Ward on every closed block, the
+ * same centroids in bf16, the same keys read for every query.
+ *
+ * The golden cases (lsa_golden.h, from tests/mklsagolden.py golden) are generated here and there
+ * from one integer generator, so only the reference's answers are checked in. They must match
+ * exactly. The reference sums its dot products in a GEMM and ref_lsa.h in one chain, so a near tie
+ * can go either way; the cases are ones where none does, and a change that moves a decision on
+ * them is a change of algorithm.
+ *
+ * With LSA_FIXTURES set to fixture files (mklsagolden.py dump: the design's own sizes, Gaussian and
+ * map-projected keys), the `fixtures` case reports how often a decision differs instead: blocks
+ * whose buckets differ, centroids that differ in bf16, and queries whose read differs, with the
+ * keys they differ by. It fails only past LSA_FIXTURE_TOL (default 1%) of blocks or reads, since a
+ * rounding-order tie is expected now and then at those sizes.
+ *
+ * Build with -ffp-contract=off, as libr4d: a contracted `a + 2 * g` is a different number. */
+#include "rad_test.h"
+
+#include "ref_lsa.h"
+#include "lsa_golden.h"
+
+#include <cinttypes>
+#include <fstream>
+#include <sstream>
+
+namespace {
+
+using rad_lsa::Geom;
+
+/* ---- mklsagolden.py's generator, restated. */
+struct SplitMix {
+    uint64_t s;
+    uint64_t next() {
+        s += 0x9E3779B97F4A7C15ull;
+        uint64_t z = s;
+        z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ull;
+        z = (z ^ (z >> 27)) * 0x94D049BB133111EBull;
+        return z ^ (z >> 31);
+    }
+    int64_t below(int64_t n) { return (int64_t)(next() % (uint64_t)n); }
+};
+
+std::vector<float> unit_f32(const std::vector<int64_t>& v) {
+    int64_t s = 0;
+    for (int64_t x : v) s += x * x;
+    const double n = std::sqrt((double)s);
+    std::vector<float> out(v.size());
+    for (size_t i = 0; i < v.size(); ++i) out[i] = (float)((double)v[i] / n);
+    return out;
+}
+
+struct Case {
+    Geom g;
+    int64_t T = 0, Q = 0;
+    std::vector<uint16_t> keys;       /* [T][dim] */
+    std::vector<float>    queries;    /* [Q][dim] */
+    std::vector<int64_t>  positions;  /* [Q] */
+};
+
+Case generate(const LsaGolden& G) {
+    Case c;
+    c.g.window = G.window; c.g.sink = G.sink; c.g.top_k = G.top_k; c.g.top_p = G.top_p;
+    c.g.pool = G.pool; c.g.bucket = G.bucket; c.g.cap = G.cap; c.g.dim = 64;
+    c.T = G.T; c.Q = G.Q;
+    const int64_t D = 64;
+    SplitMix r{G.seed};
+    std::vector<std::vector<int64_t>> centers(12, std::vector<int64_t>(D));
+    for (auto& ce : centers) for (auto& x : ce) x = r.below(201) - 100;
+    c.keys.resize((size_t)(c.T * D));
+    int64_t cur = 0, run = 0;
+    for (int64_t t = 0; t < c.T; ++t) {
+        std::vector<int64_t> v((size_t)D);
+        if (G.kind == 0) {
+            for (auto& x : v) x = r.below(255) - 127;
+        } else {
+            if (run == 0) { cur = r.below(12); run = 1 + r.below(40); }
+            --run;
+            for (int64_t d = 0; d < D; ++d) v[(size_t)d] = centers[(size_t)cur][(size_t)d] + r.below(41) - 20;
+        }
+        if (std::all_of(v.begin(), v.end(), [](int64_t x) { return x == 0; })) v[0] = 1;
+        const std::vector<float> u = unit_f32(v);
+        for (int64_t d = 0; d < D; ++d) c.keys[(size_t)(t * D + d)] = rad_lsa::f32_bf16(u[(size_t)d]);
+    }
+    c.queries.resize((size_t)(c.Q * D));
+    c.positions.resize((size_t)c.Q);
+    for (int64_t i = 0; i < c.Q; ++i) {
+        const int64_t p = c.g.window + r.below(c.T - c.g.window);
+        c.positions[(size_t)i] = p;
+        const int64_t near = r.below(p + 1);
+        std::vector<int64_t> v((size_t)D);
+        for (int64_t d = 0; d < D; ++d) {
+            const double base = (double)rad_lsa::bf16_f32(c.keys[(size_t)(near * D + d)]);
+            v[(size_t)d] = (int64_t)std::nearbyint(base * 100.0) + r.below(61) - 30;
+        }
+        if (std::all_of(v.begin(), v.end(), [](int64_t x) { return x == 0; })) v[0] = 1;
+        const std::vector<float> u = unit_f32(v);
+        std::copy(u.begin(), u.end(), c.queries.begin() + i * D);
+    }
+    return c;
+}
+
+uint64_t fnv(const int32_t* v, size_t n) {
+    uint64_t h = 0xCBF29CE484222325ull;
+    for (size_t i = 0; i < n; ++i)
+        for (int b = 0; b < 4; ++b) h = (h ^ (((uint32_t)v[i] >> (8 * b)) & 0xffu)) * 0x100000001B3ull;
+    return h;
+}
+
+/* Every closed block clustered into pages, with Ward's labels. */
+void cluster_all(const Case& c, std::vector<uint8_t>& pages, std::vector<int32_t>& labels) {
+    const int64_t blocks = c.T / c.g.window, PB = c.g.page_bytes(), P = c.g.pools();
+    pages.assign((size_t)(blocks * PB), 0);
+    labels.assign((size_t)(blocks * P), 0);
+    for (int64_t b = 0; b < blocks; ++b)
+        CHECK_EQ(rad_lsa::cluster_block(&c.keys[(size_t)(b * c.g.window * c.g.dim)], c.g,
+                                        &pages[(size_t)(b * PB)], &labels[(size_t)(b * P)]), 0);
+}
+
+std::vector<const uint8_t*> page_list(const std::vector<uint8_t>& pages, const Geom& g) {
+    std::vector<const uint8_t*> v;
+    for (size_t o = 0; o + (size_t)g.page_bytes() <= pages.size(); o += (size_t)g.page_bytes())
+        v.push_back(&pages[o]);
+    return v;
+}
+
+}  /* namespace */
+
+/* The golden cases: every label, the centroid bits' hash and every read, exactly. */
+TEST(golden) {
+    for (const LsaGolden& G : lsa_golden) {
+        const Case c = generate(G);
+        REQUIRE(c.g.check() == nullptr);
+        std::vector<uint8_t> pages;
+        std::vector<int32_t> labels;
+        cluster_all(c, pages, labels);
+        int64_t wrong = 0;
+        for (size_t i = 0; i < labels.size(); ++i) wrong += labels[i] != G.labels[i];
+        if (wrong) std::fprintf(stderr, "%s: %lld of %zu pool labels differ\n", G.name, (long long)wrong, labels.size());
+        CHECK_EQ(wrong, (int64_t)0);
+        /* The centroid bits as the generator hashed them: int32 of each bf16. */
+        std::vector<int32_t> cb;
+        const int64_t blocks = c.T / c.g.window, NB = c.g.buckets();
+        for (int64_t b = 0; b < blocks; ++b) {
+            const uint16_t* cen = (const uint16_t*)&pages[(size_t)(b * c.g.page_bytes())];
+            for (int64_t i = 0; i < NB * c.g.dim; ++i) cb.push_back(cen[i]);
+        }
+        CHECK_EQ(fnv(cb.data(), cb.size()), G.centroid_hash);
+        const auto pl = page_list(pages, c.g);
+        std::vector<int32_t> out((size_t)c.g.width());
+        for (int64_t i = 0; i < c.Q; ++i) {
+            const int64_t n = rad_lsa::read_row(&c.queries[(size_t)(i * c.g.dim)], c.positions[(size_t)i],
+                                                pl.data(), (int64_t)pl.size(), c.g, out.data());
+            CHECK_EQ((int32_t)n, G.read_len[i]);
+            CHECK_EQ(fnv(out.data(), (size_t)n), G.read_hash[i]);
+            for (int64_t k = 1; k < n; ++k) CHECK(out[(size_t)k - 1] < out[(size_t)k]);
+        }
+    }
+}
+
+/* The page layout and the read's frame on a hand-sized case: no closed block reads the window
+ * alone; one closed block reads the sinks, every key of it past them, and the window. */
+TEST(frame) {
+    Geom g;
+    g.window = 16; g.bucket = 4; g.pool = 2; g.cap = 8; g.top_k = 64; g.top_p = 16; g.sink = 2;
+    REQUIRE(g.check() == nullptr);
+    CHECK_EQ(g.page_bytes(), (int64_t)(4 * (64 + 8) * 2));
+    std::vector<uint16_t> keys((size_t)(16 * 64));
+    for (int64_t t = 0; t < 16; ++t) keys[(size_t)(t * 64 + t % 64)] = rad_lsa::f32_bf16(1.0f);
+    std::vector<uint8_t> page((size_t)g.page_bytes());
+    REQUIRE(rad_lsa::cluster_block(keys.data(), g, page.data()) == 0);
+    /* Every key is in exactly one bucket, each bucket's members ascending. */
+    const int16_t* mem = (const int16_t*)(page.data() + g.members_offset());
+    std::vector<int> seen(16, 0);
+    for (int64_t b = 0; b < g.buckets(); ++b)
+        for (int64_t m = 0; m < g.cap && mem[b * g.cap + m] >= 0; ++m) {
+            ++seen[(size_t)mem[b * g.cap + m]];
+            if (m) CHECK(mem[b * g.cap + m - 1] < mem[b * g.cap + m]);
+        }
+    for (int s : seen) CHECK_EQ(s, 1);
+    std::vector<float> q(64, 0.0f);
+    q[0] = 1.0f;
+    std::vector<int32_t> out((size_t)g.width());
+    const uint8_t* pl[] = { page.data() };
+    CHECK_EQ(rad_lsa::read_row(q.data(), 9, pl, 1, g, out.data()), (int64_t)10);
+    for (int32_t k = 0; k < 10; ++k) CHECK_EQ(out[(size_t)k], k);
+    /* Position 16: the block is closed and the window is [1, 16], so the read is sink 0 and the
+     * window; every closed key past the sinks is in the window. */
+    CHECK_EQ(rad_lsa::read_row(q.data(), 16, pl, 1, g, out.data()), (int64_t)17);
+    /* Position 40: ws = 25, so keys 2..15 of the closed block are all read (top_k 64). */
+    const int64_t n = rad_lsa::read_row(q.data(), 40, pl, 1, g, out.data());
+    CHECK_EQ(n, (int64_t)(2 + 14 + 16));
+    CHECK_EQ(out[2], 2);
+    CHECK_EQ(out[15], 15);
+    CHECK_EQ(out[16], 25);
+    CHECK_EQ(out[(size_t)n], -1);
+}
+
+/* ---- fixtures from mklsagolden.py dump */
+namespace {
+
+struct Fixture {
+    Case c;
+    std::vector<int32_t> labels, members, sel, lens;
+    std::vector<float> centroids;
+};
+
+bool load(const std::string& path, Fixture* f) {
+    std::ifstream in(path, std::ios::binary);
+    char magic[4];
+    int32_t ver = 0;
+    int64_t h[10];
+    if (!in.read(magic, 4) || std::memcmp(magic, "LSAF", 4) || !in.read((char*)&ver, 4) || ver != 1 ||
+        !in.read((char*)h, sizeof h))
+        return false;
+    Case& c = f->c;
+    c.g.window = h[0]; c.g.sink = h[1]; c.g.top_k = h[2]; c.g.top_p = h[3]; c.g.pool = h[4];
+    c.g.bucket = h[5]; c.g.cap = h[6]; c.g.dim = h[7]; c.T = h[8]; c.Q = h[9];
+    const int64_t D = c.g.dim, blocks = c.T / c.g.window, NB = c.g.buckets();
+    auto rd = [&](auto& v, int64_t n) {
+        v.resize((size_t)n);
+        return (bool)in.read((char*)v.data(), (std::streamsize)(n * sizeof(v[0])));
+    };
+    return rd(c.keys, c.T * D) && rd(c.queries, c.Q * D) && rd(c.positions, c.Q) &&
+           rd(f->labels, blocks * c.g.pools()) && rd(f->centroids, blocks * NB * D) &&
+           rd(f->members, blocks * NB * c.g.cap) && rd(f->sel, c.Q * c.g.width()) && rd(f->lens, c.Q);
+}
+
+}  /* namespace */
+
+TEST(fixtures) {
+    const char* env = std::getenv("LSA_FIXTURES");
+    if (!env || !*env) SKIP("LSA_FIXTURES names no fixture (mklsagolden.py dump)");
+    const char* tol_env = std::getenv("LSA_FIXTURE_TOL");
+    const double tol = tol_env ? std::atof(tol_env) : 0.01;
+    std::istringstream ss(env);
+    std::string path;
+    int64_t all_blocks = 0, all_bad_blocks = 0, all_reads = 0, all_bad_reads = 0;
+    while (ss >> path) {
+        Fixture f;
+        REQUIRE(load(path, &f));
+        const Case& c = f.c;
+        REQUIRE(c.g.check() == nullptr);
+        const int64_t blocks = c.T / c.g.window, NB = c.g.buckets(), P = c.g.pools(), D = c.g.dim;
+        std::vector<uint8_t> pages;
+        std::vector<int32_t> labels;
+        cluster_all(c, pages, labels);
+        int64_t bad_blocks = 0, bad_pools = 0, bad_cen = 0, cen_n = 0;
+        for (int64_t b = 0; b < blocks; ++b) {
+            int64_t w = 0;
+            for (int64_t p = 0; p < P; ++p) w += labels[(size_t)(b * P + p)] != f.labels[(size_t)(b * P + p)];
+            bad_pools += w;
+            bad_blocks += w != 0;
+            if (w) continue;
+            const uint16_t* cen = (const uint16_t*)&pages[(size_t)(b * c.g.page_bytes())];
+            for (int64_t i = 0; i < NB * D; ++i, ++cen_n)
+                bad_cen += cen[i] != rad_lsa::f32_bf16(f.centroids[(size_t)(b * NB * D + i)]);
+        }
+        /* The read over the reference's own buckets, its centroids in bf16. */
+        std::vector<uint8_t> rp((size_t)(blocks * c.g.page_bytes()));
+        for (int64_t b = 0; b < blocks; ++b) {
+            uint8_t* pg = &rp[(size_t)(b * c.g.page_bytes())];
+            uint16_t* cen = (uint16_t*)pg;
+            int16_t* mem = (int16_t*)(pg + c.g.members_offset());
+            for (int64_t i = 0; i < NB * D; ++i)
+                cen[i] = rad_lsa::f32_bf16(f.centroids[(size_t)(b * NB * D + i)]);
+            for (int64_t i = 0; i < NB * c.g.cap; ++i) {
+                const int32_t m = f.members[(size_t)(b * NB * c.g.cap + i)];
+                mem[i] = (int16_t)(m < 0 ? -1 : m - b * c.g.window);
+            }
+        }
+        const auto pl = page_list(rp, c.g);
+        std::vector<int32_t> out((size_t)c.g.width());
+        int64_t bad_reads = 0, diff_keys = 0;
+        for (int64_t i = 0; i < c.Q; ++i) {
+            const int64_t n = rad_lsa::read_row(&c.queries[(size_t)(i * D)], c.positions[(size_t)i],
+                                                pl.data(), (int64_t)pl.size(), c.g, out.data());
+            std::vector<int32_t> want(f.sel.begin() + i * c.g.width(),
+                                      f.sel.begin() + i * c.g.width() + f.lens[(size_t)i]);
+            std::sort(want.begin(), want.end());
+            std::vector<int32_t> got(out.begin(), out.begin() + n), d;
+            std::set_symmetric_difference(got.begin(), got.end(), want.begin(), want.end(),
+                                          std::back_inserter(d));
+            bad_reads += !d.empty();
+            diff_keys += (int64_t)d.size();
+        }
+        std::printf("%s: blocks %lld, differing %lld (%lld pool labels); centroids differing in "
+                    "bf16 %lld of %lld; reads %lld, differing %lld (%lld keys in the symmetric "
+                    "differences)\n",
+                    path.c_str(), (long long)blocks, (long long)bad_blocks, (long long)bad_pools,
+                    (long long)bad_cen, (long long)cen_n, (long long)c.Q, (long long)bad_reads,
+                    (long long)diff_keys);
+        all_blocks += blocks; all_bad_blocks += bad_blocks;
+        all_reads += c.Q; all_bad_reads += bad_reads;
+    }
+    std::printf("all: blocks %lld, differing %lld; reads %lld, differing %lld\n",
+                (long long)all_blocks, (long long)all_bad_blocks, (long long)all_reads,
+                (long long)all_bad_reads);
+    CHECK(all_bad_blocks <= tol * (double)all_blocks);
+    CHECK(all_bad_reads <= tol * (double)all_reads);
+}
+
+RAD_TEST_MAIN()
