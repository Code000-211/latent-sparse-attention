+    const RadTensor *se = r4d_opt(a, LS_SEL), *ns = r4d_opt(a, LS_NSEL);
+    if (!iq || !iq->data || !cu || !cu->data || cu->dtype != RAD_I32 || cu->rank != 1 ||
+        cu->shape[0] < 2 || !sc || !sc->data || !se || !se->data)
+        return R4D_NO(RAD_E_INVAL);
+    if (iq->dtype != RAD_F32 || sc->dtype != RAD_F32 || se->dtype != RAD_I32)
+        return R4D_NO(RAD_E_DTYPE);
+    const long long M = iq->shape[0], n_seq = cu->shape[0] - 1;
+    if (iq->rank != 2 || iq->shape[1] != kDim || iq->stride[1] != 1 || !lsa_is_vec(po, M) ||
+        !lsa_is_bkt(bk, z.window, z.page_bytes()) || !lsa_is_table(bt) || bt->shape[0] < n_seq ||
+        sc->rank != 2 || sc->shape[0] < M || sc->stride[1] != 1 || se->rank != 2 ||
+        se->shape[0] < M || se->shape[1] < z.sink + z.top_k + z.window || se->stride[1] != 1 ||
+        !lsa_is_vec(ns, M))
