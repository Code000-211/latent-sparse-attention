diff --git a/libref/ref_lsa.h b/libref/ref_lsa.h
new file mode 100644
index 0000000..eae65ef
--- /dev/null
+++ b/libref/ref_lsa.h
@@ -0,0 +1,321 @@
+/* ref_lsa.h -- D-LSA's flat selector on the host: the index projection, the closed-block clustering
+ * and the decode read, in the arithmetic libr4d's kernels (r4d_lsa.hip) run.
+ *
+ * D-LSA (latent sparse attention: Prefrontal-AI, arXiv 2610.42147, Apache-2.0) has a full-attention
+ * query read sink + top_k + window keys of its history instead of all of it. Each key gets a
+ * 64-dim index key, its position-free dims projected through a learned map and normalized. When a
+ * cluster block (the `window` keys of a block, 512) has left the window, its index keys are pooled
+ * by `pool` and merged by Ward into `window / bucket` buckets, each a normalized centroid and its
+ * member positions. A query scores every bucket of the blocks closed before it, takes its `top_p`
+ * best and reads their keys best bucket first until `top_k` are held, beside the sinks and the
+ * window. There is no global re-clustering: a block is clustered once, when it closes.
+ *
+ * This is the oracle the kernels are held to, and it is the paper's CPU reference
+ * (src/lsa/core/reference.py `build_buckets` / `read`, src/lsa/core/ward.py `ward_rounds`) step for
+ * step. Where that reference leaves an order open it fixes one, and the kernels take the same, so
+ * the host, the emulator (tests/r4d_emu/test_lsa.cpp) and the card agree to the bit and differ from
+ * the torch reference only where two fp32 sums of the same terms round differently
+ * (tests/lsa_ref_test.cpp measures how often a decision moves):
+ *
+ *   - every dot product is one fmaf chain over the dims in order, from 0 (torch's is a GEMM's);
+ *   - Ward's equal-cost mutual pairs merge lower pool first (torch's argsort there is unstable);
+ *   - a centroid's norm is the same chain over its own key sum (torch's `norm` reduces in lanes);
+ *   - the index projection sums one fmaf chain per key-value head's dims, then the heads in order.
+ *
+ * The index space is the SGLang plugin's for Qwen3.5 (src/lsa/sglang/models/qwen3_5/index_space.py,
+ * KeyAndQueryProjection in sglang/index/layer_index.py): the key input is every key-value head's
+ * dims past its rotated prefix ([rot, head_dim) of each, after the k norm; partial RoPE leaves them
+ * untouched), heads side by side; the query input is each group's query heads summed in fp32 on the
+ * same dims, then rounded to bf16. Both go through a bf16 copy of the map, the product is rounded to
+ * bf16 (the plugin's bf16 GEMM output), normalized in fp32 (eps 1e-12), and the key is stored in
+ * bf16. The query stays fp32.
+ *
+ * A closed block's buckets live in one page of the `kv_lsa_bkt` group, `window` tokens a page:
+ * centroids [buckets][dim] bf16, then members [buckets][cap] int16, block-local positions in
+ * position order, -1 past a bucket's size (`Geom::page_bytes`).
+ *
+ * Header-only and free of the engine, so libref, the tests and a tool include it alike. */
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <vector>
+
+namespace rad_lsa {
+
+/* The flat design's knobs, in the paper's names; the defaults are its flat settings
+ * (src/lsa/sglang/settings/design.py IndexerConfig). The cluster block is `window` keys. */
+struct Geom {
+    int64_t window = 512;   /* recent keys always read, and a cluster block's keys */
+    int64_t sink   = 4;     /* first keys always read */
+    int64_t top_k  = 4096;  /* long-range keys read besides the sinks and the window */
+    int64_t top_p  = 1024;  /* buckets a query picks */
+    int64_t pool   = 4;     /* consecutive keys clustered as one */
+    int64_t bucket = 8;     /* average keys in a bucket */
+    int64_t cap    = 16;    /* most keys in a bucket */
+    int64_t dim    = 64;    /* index dims */
+
+    int64_t buckets() const { return window / bucket; }   /* a cluster block's */
+    int64_t pools() const { return window / pool; }
+    /* A read row: sinks, then the expansion, then the window (the contract's S_max). */
+    int64_t width() const { return sink + top_k + window; }
+    int64_t members_offset() const { return buckets() * dim * 2; }
+    int64_t page_bytes() const { return buckets() * (dim + cap) * 2; }
+
+    /* Null when the sizes nest as the design requires, else why not (IndexerConfig's checks: a
+     * cap under twice the bucket lets Ward stop short of its count; top_p buckets must be able to
+     * fill top_k). Members are int16, so a block is at most 32768 keys. */
+    const char* check() const {
+        if (window < 1 || sink < 0 || top_k < 1 || top_p < 1 || pool < 1 || bucket < 1 ||
+            cap < 1 || dim < 1)
+            return "every size must be positive (sink may be 0)";
+        if (bucket % pool || window % bucket)
+            return "pool must divide bucket, and bucket must divide window";
+        if (cap < 2 * bucket) return "cap must be at least twice bucket, or Ward can stop short";
+        if (cap % pool) return "pool must divide cap";
+        if (top_p * cap < top_k) return "top_p buckets of cap keys cannot fill top_k";
+        if (window > 32768) return "a cluster block's members are int16, so window <= 32768";
+        return nullptr;
+    }
+};
+
+/* ---- bf16, round to nearest even; a NaN stays a quiet NaN. */
+inline float bf16_f32(uint16_t h) {
+    const uint32_t u = (uint32_t)h << 16;
+    float f;
+    std::memcpy(&f, &u, 4);
+    return f;
+}
+inline uint16_t f32_bf16(float f) {
+    uint32_t u;
+    std::memcpy(&u, &f, 4);
+    if ((u & 0x7fffffffu) > 0x7f800000u) return (uint16_t)((u >> 16) | 0x40u);
+    u += 0x7fffu + ((u >> 16) & 1u);
+    return (uint16_t)(u >> 16);
+}
+
+/* The one dot product: an fmaf chain over the dims in order, from 0. */
+inline float dot(const float* a, const float* b, int64_t n) {
+    float acc = 0.0f;
+    for (int64_t i = 0; i < n; ++i) acc = std::fmaf(a[i], b[i], acc);
+    return acc;
+}
+
+/* ================================================================== the index projection */
+/* `x` [n_kv * free] f32 (already bf16 values) through `w` [n_kv * free][dim] bf16: one fmaf chain
+ * per key-value head's `free` rows, the heads summed in order, the product rounded to bf16 and
+ * normalized. `out` [dim] f32 unit (zero stays zero). */
+inline void project(const float* x, const uint16_t* w, int64_t n_kv, int64_t free, int64_t dim,
+                    float* out) {
+    std::vector<float> y((size_t)dim);
+    for (int64_t j = 0; j < dim; ++j) {
+        float total = 0.0f;
+        for (int64_t h = 0; h < n_kv; ++h) {
+            float acc = 0.0f;
+            for (int64_t i = 0; i < free; ++i) {
+                const int64_t r = h * free + i;
+                acc = std::fmaf(x[r], bf16_f32(w[r * dim + j]), acc);
+            }
+            total = h == 0 ? acc : total + acc;
+        }
+        y[(size_t)j] = bf16_f32(f32_bf16(total));
+    }
+    const float n = std::sqrt(dot(y.data(), y.data(), dim));
+    const float d = n > 1e-12f ? n : 1e-12f;
+    for (int64_t j = 0; j < dim; ++j) out[j] = y[(size_t)j] / d;
+}
+
+/* One token's index key from its key heads `k` [n_kv][head_dim] bf16 (normed and rotated):
+ * `out` [dim] bf16. */
+inline void index_key(const uint16_t* k, int64_t n_kv, int64_t head_dim, int64_t rot,
+                      const uint16_t* w_k, int64_t dim, uint16_t* out) {
+    const int64_t free = head_dim - rot;
+    std::vector<float> x((size_t)(n_kv * free)), y((size_t)dim);
+    for (int64_t h = 0; h < n_kv; ++h)
+        for (int64_t i = 0; i < free; ++i)
+            x[(size_t)(h * free + i)] = bf16_f32(k[h * head_dim + rot + i]);
+    project(x.data(), w_k, n_kv, free, dim, y.data());
+    for (int64_t j = 0; j < dim; ++j) out[j] = f32_bf16(y[(size_t)j]);
+}
+
+/* One token's index query from its query heads `q` [n_head][head_dim] bf16: each group's heads
+ * summed in fp32 in head order and rounded to bf16, then projected. `out` [dim] f32. */
+inline void index_query(const uint16_t* q, int64_t n_head, int64_t n_kv, int64_t head_dim,
+                        int64_t rot, const uint16_t* w_q, int64_t dim, float* out) {
+    const int64_t free = head_dim - rot, group = n_head / n_kv;
+    std::vector<float> x((size_t)(n_kv * free));
+    for (int64_t g = 0; g < n_kv; ++g)
+        for (int64_t i = 0; i < free; ++i) {
+            float s = 0.0f;
+            for (int64_t r = 0; r < group; ++r) s += bf16_f32(q[(g * group + r) * head_dim + rot + i]);
+            x[(size_t)(g * free + i)] = bf16_f32(f32_bf16(s));
+        }
+    project(x.data(), w_q, n_kv, free, dim, out);
+}
+
+/* ================================================================== Ward */
+/* ward.py `ward_rounds` over one block's `P` pool keys `ks` [P][D] (merged in place): rounds of
+ * mutual-cheapest merges under the cap until `nb` buckets remain. `labels` [P] gets each pool's
+ * bucket, numbered in the order of its first pool. Returns the buckets left, `nb` unless the cap
+ * stopped it (never at cap >= 2 * bucket). The merge cost of buckets i and j is
+ * |s_i| + |s_j| - |s_i + s_j| over their key sums s, from the squares and the cross dot:
+ * (sq_i + sq_j) + 2 g_ij, clamped at 0, as torch evaluates it. */
+inline int64_t ward(float* ks, int64_t P, int64_t D, float pool_size, int64_t nb, float cap,
+                    int32_t* labels) {
+    const float inf = std::numeric_limits<float>::infinity();
+    std::vector<float> size((size_t)P, pool_size), sq((size_t)P), al((size_t)P), cost((size_t)P);
+    std::vector<int32_t> best((size_t)P), parent((size_t)P);
+    std::vector<uint8_t> alive((size_t)P, 1), mutual((size_t)P);
+    for (int64_t i = 0; i < P; ++i) parent[(size_t)i] = (int32_t)i;
+    int64_t n_alive = P;
+    for (int round = 0; round < 256; ++round) {
+        const int64_t left = n_alive - nb;
+        if (left <= 0) break;
+        for (int64_t i = 0; i < P; ++i) {
+            if (!alive[(size_t)i]) continue;
+            sq[(size_t)i] = dot(ks + i * D, ks + i * D, D);
+            al[(size_t)i] = std::sqrt(sq[(size_t)i] > 0.0f ? sq[(size_t)i] : 0.0f);
+        }
+        for (int64_t i = 0; i < P; ++i) {
+            float bc = inf;
+            int32_t bj = 0;
+            if (alive[(size_t)i])
+                for (int64_t j = 0; j < P; ++j) {
+                    if (j == i || !alive[(size_t)j] || size[(size_t)i] + size[(size_t)j] > cap)
+                        continue;
+                    const float g = dot(ks + i * D, ks + j * D, D);
+                    const float m2 = (sq[(size_t)i] + sq[(size_t)j]) + 2.0f * g;
+                    const float c = (al[(size_t)i] + al[(size_t)j]) - std::sqrt(m2 > 0.0f ? m2 : 0.0f);
+                    if (c < bc) { bc = c; bj = (int32_t)j; }
+                }
+            cost[(size_t)i] = bc;
+            best[(size_t)i] = bj;
+        }
+        bool any = false;
+        for (int64_t i = 0; i < P; ++i) {
+            const int32_t b = best[(size_t)i];
+            mutual[(size_t)i] = alive[(size_t)i] && cost[(size_t)i] < inf &&
+                                best[(size_t)b] == (int32_t)i && i < b;
+        }
+        /* The cheapest `left` mutual pairs merge, an equal cost to the lower pool. */
+        std::vector<uint8_t> take((size_t)P, 0);
+        for (int64_t i = 0; i < P; ++i) {
+            if (!mutual[(size_t)i]) continue;
+            int64_t r = 0;
+            for (int64_t k = 0; k < P; ++k)
+                if (mutual[(size_t)k] && (cost[(size_t)k] < cost[(size_t)i] ||
+                                          (cost[(size_t)k] == cost[(size_t)i] && k < i)))
+                    ++r;
+            if (r < left) { take[(size_t)i] = 1; any = true; }
+        }
+        if (!any) break;
+        for (int64_t i = 0; i < P; ++i) {
+            if (!take[(size_t)i]) continue;
+            const int32_t b = best[(size_t)i];
+            for (int64_t d = 0; d < D; ++d) ks[i * D + d] += ks[b * D + d];
+            size[(size_t)i] += size[(size_t)b];
+            alive[(size_t)b] = 0;
+            parent[(size_t)b] = (int32_t)i;
+            --n_alive;
+        }
+    }
+    std::vector<int32_t> number((size_t)P);
+    int32_t n = -1;
+    for (int64_t i = 0; i < P; ++i) {
+        n += alive[(size_t)i];
+        number[(size_t)i] = n;
+    }
+    for (int64_t p = 0; p < P; ++p) {
+        int32_t r = (int32_t)p;
+        while (parent[(size_t)r] != r) r = parent[(size_t)r];
+        labels[p] = number[(size_t)r];
+    }
+    return n_alive;
+}
+
+/* ================================================================== a closed block */
+/* reference.py `build_buckets` for one closed block: `keys` [window][dim] bf16 in position order
+ * into `page` (Geom::page_bytes). The pools are sums of `pool` consecutive keys in order; a
+ * bucket's key sum adds its keys in position order (torch's index_add_), its centroid is that sum
+ * over its norm (clamped at 1e-30) rounded to bf16. `labels_out` [pools], if given, gets Ward's
+ * labels. Returns 0, or -1 when Ward stopped short (unreachable when Geom::check passes). */
+inline int cluster_block(const uint16_t* keys, const Geom& g, uint8_t* page,
+                         int32_t* labels_out = nullptr) {
+    const int64_t W = g.window, D = g.dim, P = g.pools(), NB = g.buckets();
+    std::vector<float> ks((size_t)(P * D));
+    for (int64_t p = 0; p < P; ++p)
+        for (int64_t d = 0; d < D; ++d) {
+            float acc = 0.0f;
+            for (int64_t k = 0; k < g.pool; ++k) acc += bf16_f32(keys[(p * g.pool + k) * D + d]);
+            ks[(size_t)(p * D + d)] = acc;
+        }
+    std::vector<int32_t> labels((size_t)P);
+    const int64_t left = ward(ks.data(), P, D, (float)g.pool, NB, (float)g.cap, labels.data());
+    if (labels_out) std::memcpy(labels_out, labels.data(), (size_t)P * 4);
+    if (left != NB) return -1;
+    std::vector<float> sums((size_t)(NB * D), 0.0f);
+    for (int64_t t = 0; t < W; ++t) {
+        const int64_t b = labels[(size_t)(t / g.pool)];
+        for (int64_t d = 0; d < D; ++d) sums[(size_t)(b * D + d)] += bf16_f32(keys[t * D + d]);
+    }
+    uint16_t* cen = (uint16_t*)page;
+    int16_t*  mem = (int16_t*)(page + g.members_offset());
+    for (int64_t b = 0; b < NB; ++b) {
+        const float* s = &sums[(size_t)(b * D)];
+        float n = std::sqrt(dot(s, s, D));
+        if (!(n > 1e-30f)) n = 1e-30f;
+        for (int64_t d = 0; d < D; ++d) cen[b * D + d] = f32_bf16(s[d] / n);
+        int64_t m = 0;
+        for (int64_t t = 0; t < W; ++t)
+            if (labels[(size_t)(t / g.pool)] == b && m < g.cap) mem[b * g.cap + m++] = (int16_t)t;
+        for (; m < g.cap; ++m) mem[b * g.cap + m] = -1;
+    }
+    return 0;
+}
+
+/* ================================================================== the read */
+/* reference.py `read` for one query: `q` [dim] f32 at position `pos`, against the pages of the
+ * sequence's closed blocks (`pages[b]` is block b's, `n_pages` of them). Every bucket of the blocks
+ * closed before the query (pos / window of them) is scored by q . centroid; the `top_p` best, an
+ * equal score to the lower bucket, are read best first, each bucket's members in position order,
+ * keeping those past the sinks and before the window, until `top_k` are held (the last bucket cut
+ * short). `out` [Geom::width] gets the sinks, the expansion and the window as one ascending list,
+ * -1 padded; returns its length. */
+inline int64_t read_row(const float* q, int64_t pos, const uint8_t* const* pages, int64_t n_pages,
+                        const Geom& g, int32_t* out) {
+    const int64_t W = g.window, D = g.dim, NB = g.buckets();
+    const int64_t blocks = std::min(pos / W, n_pages), n = blocks * NB;
+    std::vector<float> score((size_t)n), c((size_t)D);
+    for (int64_t b = 0; b < n; ++b) {
+        const uint16_t* cen = (const uint16_t*)pages[b / NB] + (b % NB) * D;
+        for (int64_t d = 0; d < D; ++d) c[(size_t)d] = bf16_f32(cen[d]);
+        score[(size_t)b] = dot(q, c.data(), D);
+    }
+    std::vector<int64_t> order((size_t)n);
+    for (int64_t b = 0; b < n; ++b) order[(size_t)b] = b;
+    std::stable_sort(order.begin(), order.end(),
+                     [&](int64_t x, int64_t y) { return score[(size_t)x] > score[(size_t)y]; });
+    const int64_t ws = pos + 1 - W > 0 ? pos + 1 - W : 0;
+    std::vector<int32_t> exp;
+    for (int64_t r = 0; r < n && r < g.top_p && (int64_t)exp.size() < g.top_k; ++r) {
+        const int64_t b = order[(size_t)r];
+        const int16_t* mem = (const int16_t*)(pages[b / NB] + g.members_offset()) + (b % NB) * g.cap;
+        for (int64_t m = 0; m < g.cap && (int64_t)exp.size() < g.top_k; ++m) {
+            if (mem[m] < 0) break;
+            const int64_t at = (b / NB) * W + mem[m];
+            if (at >= g.sink && at < ws) exp.push_back((int32_t)at);
+        }
+    }
+    std::sort(exp.begin(), exp.end());
+    int64_t o = 0;
+    for (int64_t t = 0; t < std::min(g.sink, ws); ++t) out[o++] = (int32_t)t;
+    for (int32_t t : exp) out[o++] = t;
+    for (int64_t t = ws; t <= pos; ++t) out[o++] = (int32_t)t;
+    for (int64_t i = o; i < g.width(); ++i) out[i] = -1;
+    return o;
+}
+
+}  /* namespace rad_lsa */
