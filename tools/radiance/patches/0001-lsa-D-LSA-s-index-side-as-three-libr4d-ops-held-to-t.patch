+#!/usr/bin/env python3
+"""D-LSA's torch reference, run for tests/lsa_ref_test.cpp: the golden cases it checks, or fixtures for a bulk run.
+
+The reference is the paper's CPU oracle, `lsa.core.reference` (`build_buckets`, `read`) from
+https://github.com/Prefrontal-AI/latent-sparse-attention (Apache-2.0); put its `src/` on PYTHONPATH.
+
+    mklsagolden.py golden > tests/lsa_golden.h
+    mklsagolden.py dump OUT [--map MAP.pt] [--cases N] [--seed S]
+
+`golden` writes small cases whose inputs both sides rebuild from an integer generator (splitmix64,
+integers normalized in float64 and rounded to float32, then to bf16), so the header carries only
+the reference's answers: every block's Ward labels, a hash of the bf16 centroids and, per query,
+its read's length and a hash of its sorted keys.
+
+`dump` writes fixtures at the design's own sizes (window 512, top_k 4096, top_p 1024, ...) from
+torch's generator, the inputs stored beside the answers: unit Gaussian keys, and with --map
+"real-looking" ones, slowly drifting position-free keys and queries through a published map's
+first layer, normalized as the SGLang plugin does. `lsa_ref_test --fixture F...` reports how often
+ref_lsa.h's decisions differ from the reference's.
+
+The read is the reference's over its own buckets with the centroids rounded to bf16, the form
+radiance stores them in, so a fixture holds ref_lsa.h's read to the reference's with clustering
+differences taken out.
+"""
+
+import struct
+import sys
+
+import numpy as np
+import torch
+
+from lsa.core.reference import Buckets, build_buckets, read
+
+MASK = (1 << 64) - 1
+
+
+class SplitMix:
+    """splitmix64, the generator tests/lsa_ref_test.cpp restates."""
+
+    def __init__(self, seed):
+        self.s = seed & MASK
+
+    def next(self):
+        self.s = (self.s + 0x9E3779B97F4A7C15) & MASK
+        z = self.s
+        z = ((z ^ (z >> 30)) * 0xBF58476D1CE4E5B9) & MASK
+        z = ((z ^ (z >> 27)) * 0x94D049BB133111EB) & MASK
+        return z ^ (z >> 31)
+
+    def below(self, n):
+        return self.next() % n
+
+
+def unit_f32(ints):
+    """Integers to a float32 unit row: the norm and quotient in float64, then one rounding."""
+    norm = float(np.sqrt(np.float64(sum(int(v) * int(v) for v in ints))))
+    return np.array([np.float64(v) / norm for v in ints], dtype=np.float64).astype(np.float32)
+
+
+def bf16_bits(f32):
+    """float32 to bf16 bits, round to nearest even."""
+    u = np.asarray(f32, dtype=np.float32).view(np.uint32).astype(np.uint64)
+    u = (u + 0x7FFF + ((u >> 16) & 1)) >> 16
+    return u.astype(np.uint16)
+
+
+def bits_f32(bits):
+    return (np.asarray(bits, dtype=np.uint16).astype(np.uint32) << 16).view(np.float32)
+
+
+def gen_case(seed, T, Q, dim, kind, window):
+    """The integer generator's keys [T, dim] bf16 bits, queries [Q, dim] f32 and positions [Q].
+
+    kind 0: independent rows. kind 1: runs of rows near one of 12 centers, a run 1-40 rows long.
+    Queries sit at positions from window to T - 1, a query near a random earlier key.
+    """
+    g = SplitMix(seed)
+    keys = np.zeros((T, dim), dtype=np.uint16)
+    centers = [[int(g.below(201)) - 100 for _ in range(dim)] for _ in range(12)]
+    c, run = 0, 0
+    for t in range(T):
+        if kind == 0:
+            v = [int(g.below(255)) - 127 for _ in range(dim)]
+        else:
+            if run == 0:
+                c, run = int(g.below(12)), 1 + int(g.below(40))
+            run -= 1
+            v = [centers[c][d] + int(g.below(41)) - 20 for d in range(dim)]
+        if all(x == 0 for x in v):
+            v[0] = 1
+        keys[t] = bf16_bits(unit_f32(v))
+    queries = np.zeros((Q, dim), dtype=np.float32)
+    positions = np.zeros(Q, dtype=np.int64)
+    for i in range(Q):
+        p = window + int(g.below(T - window))
+        positions[i] = p
+        near = int(g.below(p + 1))
+        base = bits_f32(keys[near])
+        v = [int(round(float(base[d]) * 100)) + int(g.below(61)) - 30 for d in range(dim)]
+        if all(x == 0 for x in v):
+            v[0] = 1
+        queries[i] = unit_f32(v)
+    return keys, queries, positions
+
+
+def oracle(keys_bits, queries, positions, geo):
+    """The reference's buckets over the keys and its reads over them with bf16 centroids."""
+    W, sink, top_k, top_p, pool, bucket, cap = (geo[k] for k in ("window", "sink", "top_k", "top_p", "pool", "bucket", "cap"))
+    keys = torch.from_numpy(bits_f32(keys_bits).copy()).to(torch.bfloat16)
+    b = build_buckets(keys, pool, bucket, cap, W)
+    blocks = keys.shape[0] // W
+    P = W // pool
+    # Labels again, from the members: a pool's bucket is the bucket its first key is in
+    labels = np.zeros((blocks, P), dtype=np.int32)
+    members = b.bucket_members.numpy()
+    nb = W // bucket
+    for row in range(members.shape[0]):
+        for m in members[row]:
+            if m >= 0 and m % pool == 0:
+                labels[row // nb, (m % W) // pool] = row % nb
+    c16 = b.bucket_centroids.to(torch.bfloat16).float()
+    b16 = Buckets(c16, b.bucket_members, b.bucket_sizes, b.block_bucket_count, b.cluster_block_size)
+    sel, lens = read(torch.from_numpy(queries.copy()), torch.from_numpy(positions.copy()), b16, top_p, top_k, sink, W)
+    return labels, b.bucket_centroids.numpy(), members, sel.numpy(), lens.numpy()
+
+
+def fnv(values):
+    h = 0xCBF29CE484222325
+    for v in values:
+        for byte in struct.pack("<i", int(v)):
+            h = ((h ^ byte) * 0x100000001B3) & MASK
+    return h
+
+
+GOLDEN = [
+    # name, seed, T, Q, kind, window, sink, top_k, top_p, pool, bucket, cap
+    ("small_random", 1, 1024, 12, 0, 64, 4, 96, 24, 4, 8, 16),
+    ("small_runs", 2, 1024, 12, 1, 64, 4, 96, 24, 4, 8, 16),
+    ("design_runs", 3, 3072, 6, 1, 512, 4, 1024, 160, 4, 8, 16),
+    ("cap_tight", 4, 768, 8, 1, 128, 0, 200, 16, 2, 8, 16),
+]
+
+
+def golden():
+    out = [
+        "/* lsa_golden.h -- the D-LSA torch reference's answers on tests/lsa_ref_test.cpp's generated cases.",
+        " * Generated by tests/mklsagolden.py golden from Prefrontal-AI/latent-sparse-attention's",
+        " * src/lsa/core/reference.py; do not edit. */",
+        "#pragma once",
+        "#include <cstdint>",
+        "",
+        "struct LsaGolden {",
+        "    const char* name;",
+        "    uint64_t seed;",
+        "    int64_t T, Q, kind, window, sink, top_k, top_p, pool, bucket, cap;",
+        "    const int8_t* labels;      /* [T / window][window / pool] */",
+        "    uint64_t centroid_hash;    /* fnv over the bf16 centroid bits, as int32 */",
+        "    const int32_t* read_len;   /* [Q] */",
+        "    const uint64_t* read_hash; /* [Q] fnv over the sorted keys */",
+        "};",
+        "",
+    ]
+    entries = []
+    for name, seed, T, Q, kind, W, sink, top_k, top_p, pool, bucket, cap in GOLDEN:
+        geo = dict(window=W, sink=sink, top_k=top_k, top_p=top_p, pool=pool, bucket=bucket, cap=cap)
+        keys, queries, positions = gen_case(seed, T, Q, 64, kind, W)
+        labels, cen, _, sel, lens = oracle(keys, queries, positions, geo)
+        chash = fnv(bf16_bits(cen).astype(np.int32).flatten())
+        hashes = [fnv(sorted(int(x) for x in sel[i, : lens[i]])) for i in range(Q)]
+        lab = ", ".join(str(int(x)) for x in labels.flatten())
+        out.append(f"static const int8_t lsa_{name}_labels[] = {{ {lab} }};")
+        out.append(f"static const int32_t lsa_{name}_len[] = {{ {', '.join(str(int(x)) for x in lens)} }};")
+        out.append(f"static const uint64_t lsa_{name}_hash[] = {{ {', '.join(f'0x{h:016x}ull' for h in hashes)} }};")
+        entries.append(
+            f'    {{ "{name}", {seed}, {T}, {Q}, {kind}, {W}, {sink}, {top_k}, {top_p}, {pool}, {bucket}, {cap},\n'
+            f"      lsa_{name}_labels, 0x{chash:016x}ull, lsa_{name}_len, lsa_{name}_hash }},"
+        )
+    out.append("")
+    out.append("static const LsaGolden lsa_golden[] = {")
+    out.extend(entries)
+    out.append("};")
+    print("\n".join(out))
+
+
+def write_fixture(path, geo, keys_bits, queries, positions):
+    labels, cen, members, sel, lens = oracle(keys_bits, queries, positions, geo)
+    T, dim = keys_bits.shape
+    Q = queries.shape[0]
+    with open(path, "wb") as f:
+        f.write(b"LSAF")
+        f.write(struct.pack("<i", 1))
+        f.write(struct.pack("<10q", geo["window"], geo["sink"], geo["top_k"], geo["top_p"], geo["pool"],
+                            geo["bucket"], geo["cap"], dim, T, Q))
+        f.write(keys_bits.astype("<u2").tobytes())
+        f.write(queries.astype("<f4").tobytes())
+        f.write(positions.astype("<i8").tobytes())
+        f.write(labels.astype("<i4").tobytes())
+        f.write(cen.astype("<f4").tobytes())
+        f.write(members.astype("<i4").tobytes())
+        f.write(sel.astype("<i4").tobytes())
+        f.write(lens.astype("<i4").tobytes())
+
+
+def real_looking(gen, T, Q, wq, wk):
+    """Position-free keys that drift (each a mix of a slow walk and a topic held for a run) through the key map,
+    and queries near earlier keys' inputs through the query map, normalized as KeyAndQueryProjection does."""
+    key_dim = wk.shape[0]
+    scale = torch.rand(key_dim, generator=gen) * 2 + 0.25
+    topics = torch.randn(48, key_dim, generator=gen)
+    walk = torch.zeros(key_dim)
+    x = torch.zeros(T, key_dim)
+    topic, run = 0, 0
+    for t in range(T):
+        if run == 0:
+            topic = int(torch.randint(48, (1,), generator=gen))
+            run = int(torch.randint(1, 200, (1,), generator=gen))
+        run -= 1
+        walk = 0.97 * walk + 0.25 * torch.randn(key_dim, generator=gen)
+        x[t] = (topics[topic] + walk + 0.6 * torch.randn(key_dim, generator=gen)) * scale
+    keys = torch.nn.functional.normalize(
+        (x.to(torch.bfloat16) @ wk.to(torch.bfloat16)).float(), dim=-1).to(torch.bfloat16)
+    positions = torch.randint(512, T, (Q,), generator=gen)
+    qx = torch.zeros(Q, key_dim)
+    for i in range(Q):
+        p = int(positions[i])
+        near = int(torch.randint(0, p + 1, (1,), generator=gen))
+        qx[i] = x[near] * 6 + 3 * torch.randn(key_dim, generator=gen) * scale
+    queries = torch.nn.functional.normalize((qx.to(torch.bfloat16) @ wq.to(torch.bfloat16)).float(), dim=-1)
+    keys_bits = keys.view(torch.int16).numpy().view(np.uint16)
+    return keys_bits, queries.numpy(), positions.numpy().astype(np.int64)
+
+
+def dump(argv):
+    out = argv[0]
+    mp, cases, seed = None, 4, 0
+    i = 1
+    while i < len(argv):
+        if argv[i] == "--map":
+            mp = argv[i + 1]
+        elif argv[i] == "--cases":
+            cases = int(argv[i + 1])
+        elif argv[i] == "--seed":
+            seed = int(argv[i + 1])
+        i += 2
+    geo = dict(window=512, sink=4, top_k=4096, top_p=1024, pool=4, bucket=8, cap=16)
+    gen = torch.Generator().manual_seed(seed)
+    import os
+    os.makedirs(out, exist_ok=True)
+    for c in range(cases):
+        T, Q = 16384, 64
+        k = torch.nn.functional.normalize(torch.randn(T, 64, generator=gen), dim=-1).to(torch.bfloat16)
+        keys_bits = k.view(torch.int16).numpy().view(np.uint16)
+        positions = torch.randint(512, T, (Q,), generator=gen).numpy().astype(np.int64)
+        queries = torch.nn.functional.normalize(torch.randn(Q, 64, generator=gen), dim=-1).numpy()
+        write_fixture(f"{out}/random_{seed}_{c}.bin", geo, keys_bits, queries, positions)
+        print(f"{out}/random_{seed}_{c}.bin", flush=True)
+        if mp is not None:
+            maps = torch.load(mp, map_location="cpu", weights_only=True)
+            layers = sorted({int(n.split(".")[0]) for n in maps})
+            layer = layers[c % len(layers)]
+            keys_bits, queries, positions = real_looking(gen, T, Q, maps[f"{layer}.W_Q_idx"], maps[f"{layer}.W_K_idx"])
+            write_fixture(f"{out}/real_{seed}_{c}_L{layer}.bin", geo, keys_bits, queries, positions)
+            print(f"{out}/real_{seed}_{c}_L{layer}.bin", flush=True)
+
+
+if __name__ == "__main__":
+    torch.set_num_threads(1)
+    if len(sys.argv) >= 2 and sys.argv[1] == "golden":
+        golden()
+    elif len(sys.argv) >= 3 and sys.argv[1] == "dump":
+        dump(sys.argv[2:])
+    else:
+        sys.exit(__doc__)
