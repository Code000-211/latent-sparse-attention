+/* lsa_device_test.cpp -- D-LSA's index side (libr4d/r4d_lsa.hip) on a card, against libref/ref_lsa.h.
+ *
+ *   lsa_device_test LIB [--bench]
+ *
+ * LIB is libr4d.so, or any library exporting r4d_rad_lsa_index_store, r4d_rad_lsa_cluster and
+ * r4d_rad_lsa_select. The fixtures are tests/lsa_cases.h's, as the emulator runs them
+ * (tests/r4d_emu/test_lsa.cpp), plus the select at the flat design's own budget (top_k 4096, top_p
+ * 1024) and a tie straddling its top_p; every result must equal the host's to the byte.
+ *
+ * --bench times each op alone, warm, by events over repeated launches: the store at a decode row
+ * and a prefill chunk, the clustering of one block and of a chunk's sixteen, and the select of one
+ * decode row at 128k and 512k of context (synthetic pages: unit centroids, eight keys a bucket),
+ * which is the per-layer cost a decode step pays sixteen times on Qwen3.8-27B.
+ *
+ * Exit status 77 when no card is visible, as the harness's skip. */
+#include "rad_abi.h"
+#include "lsa_cases.h"
+
+#include <hip/hip_runtime.h>
+#include <dlfcn.h>
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <string>
+
+namespace {
+
+void hipcheck(hipError_t e, const char* what) {
+    if (e != hipSuccess) {
+        std::fprintf(stderr, "HIP %s: %s\n", what, hipGetErrorString(e));
+        std::exit(1);
+    }
+}
+
+struct Lib {
+    void* h = nullptr;
+    std::map<std::string, lsa_cases::Launch> fns;
+    lsa_cases::Launch at(const char* sym) {
+        auto it = fns.find(sym);
+        if (it != fns.end()) return it->second;
+        auto f = reinterpret_cast<lsa_cases::Launch>(dlsym(h, sym));
+        if (!f) {
+            std::fprintf(stderr, "%s exports no %s\n", "the library", sym);
+            std::exit(1);
+        }
+        return fns[sym] = f;
+    }
+};
+
+/* The operands on the card for one call: copied in, the call, copied back. With `reps` > 0 the
+ * call is repeated that many times after a warm launch and the mean time returned in *us. */
+int device_call(Lib& lib, hipStream_t st, const char* sym, std::vector<lsa_cases::Opd>& t,
+                const std::vector<RadParam>& p, int reps = 0, double* us = nullptr) {
+    std::vector<void*> dev(t.size(), nullptr);
+    std::vector<RadTensor> ts;
+    for (size_t i = 0; i < t.size(); ++i) {
+        hipcheck(hipMalloc(&dev[i], t[i].bytes ? t[i].bytes : 16), "malloc");
+        hipcheck(hipMemcpy(dev[i], t[i].data, t[i].bytes, hipMemcpyHostToDevice), "copy in");
+        ts.push_back(lsa_cases::tensor_of(t[i], dev[i]));
+    }
+    RadArgs a{};
+    a.t = ts.data();
+    a.n_t = (int)ts.size();
+    a.p = p.data();
+    a.n_p = (int)p.size();
+    const lsa_cases::Launch fn = lib.at(sym);
+    int rc = fn(&a, (RadStream)st);
+    hipcheck(hipStreamSynchronize(st), sym);
+    if (reps > 0 && rc == RAD_OK) {
+        hipEvent_t e0, e1;
+        hipcheck(hipEventCreate(&e0), "event");
+        hipcheck(hipEventCreate(&e1), "event");
+        hipcheck(hipEventRecord(e0, st), "record");
+        for (int r = 0; r < reps && rc == RAD_OK; ++r) rc = fn(&a, (RadStream)st);
+        hipcheck(hipEventRecord(e1, st), "record");
+        hipcheck(hipEventSynchronize(e1), "sync");
+        float ms = 0.0f;
+        hipcheck(hipEventElapsedTime(&ms, e0, e1), "elapsed");
+        if (us) *us = 1000.0 * ms / reps;
+        (void)hipEventDestroy(e0);
+        (void)hipEventDestroy(e1);
+    }
+    for (size_t i = 0; i < t.size(); ++i) {
+        hipcheck(hipMemcpy(t[i].data, dev[i], t[i].bytes, hipMemcpyDeviceToHost), "copy out");
+        (void)hipFree(dev[i]);
+    }
+    return rc;
+}
+
+/* ---- --bench */
+void bench(Lib& lib, hipStream_t st) {
+    using namespace lsa_cases;
+    std::mt19937_64 rng(11);
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    const rad_lsa::Geom g;
+    const int64_t D = 64, NB = g.buckets(), PB = g.page_bytes();
+    double us = 0.0;
+
+    for (int64_t T : { 1, 8192 }) {
+        const int64_t n_head = 24, n_kv = 4, hd = 256, key_dim = n_kv * 192, blocks = T / 16 + 1;
+        std::vector<uint16_t> q((size_t)(T * n_head * hd)), k((size_t)(T * n_kv * hd)), map((size_t)(2 * key_dim * D));
+        for (auto& x : q) x = bf(nd(rng));
+        for (auto& x : k) x = bf(nd(rng));
+        for (auto& x : map) x = bf(0.05f * nd(rng));
+        std::vector<int32_t> slot((size_t)T);
+        std::iota(slot.begin(), slot.end(), 0);
+        std::vector<uint16_t> cache((size_t)(blocks * 16 * D));
+        std::vector<float> iq((size_t)(T * D));
+        std::vector<Opd> t = { opd(q, RAD_BF16, { T, n_head * hd }), opd(k, RAD_BF16, { T, n_kv * hd }),
+                               opd(map, RAD_BF16, { 2 * key_dim, D }), opd(slot, RAD_I32, { T }),
+                               opd(cache, RAD_BF16, { blocks, 1, 16, D }), opd(iq, RAD_F32, { T, D }) };
+        device_call(lib, st, "r4d_rad_lsa_index_store", t,
+                    { pint("head_dim", hd), pint("n_head", n_head), pint("n_head_kv", n_kv),
+                      pint("rot", 64), pint("dim", D), pint("block_size", 16) }, 20, &us);
+        std::printf("bench lsa_index_store  %5lld rows               %9.1f us\n", (long long)T, us);
+    }
+
+    for (int64_t closing : { 1, 16 }) {
+        const int64_t ctx = closing * g.window, pages_i = ctx / 16;
+        std::vector<uint16_t> idx = structured_keys(rng, ctx, D);
+        std::vector<int32_t> ibt((size_t)pages_i), bbt((size_t)closing);
+        std::iota(ibt.begin(), ibt.end(), 0);
+        std::iota(bbt.begin(), bbt.end(), 0);
+        std::vector<uint8_t> bkt((size_t)(closing * PB));
+        std::vector<int32_t> pos, cu = { 0 };
+        if (closing == 1) pos.push_back((int32_t)(ctx - 1));
+        else for (int64_t p = 0; p < ctx; ++p) pos.push_back((int32_t)p);
+        cu.push_back((int32_t)pos.size());
+        const int64_t T = (int64_t)pos.size();
+        std::vector<Opd> t = { opd(pos, RAD_I32, { T }), opd(cu, RAD_I32, { 2 }),
+                               opd(idx, RAD_BF16, { pages_i, 1, 16, D }), opd(ibt, RAD_I32, { 1, pages_i }),
+                               opd(bkt, RAD_U8, { closing, 1, g.window, PB / g.window }),
+                               opd(bbt, RAD_I32, { 1, closing }) };
+        device_call(lib, st, "r4d_rad_lsa_cluster", t, geom_params(g), 10, &us);
+        std::printf("bench lsa_cluster      %5lld blocks closing     %9.1f us\n", (long long)closing, us);
+    }
+
+    for (int64_t ctx : { 131072, 524288 }) {
+        const int64_t blocks = ctx / g.window, buckets = blocks * NB;
+        std::vector<uint8_t> bkt((size_t)(blocks * PB));
+        for (int64_t b = 0; b < blocks; ++b) {
+            uint16_t* cen = (uint16_t*)&bkt[(size_t)(b * PB)];
+            int16_t* mem = (int16_t*)&bkt[(size_t)(b * PB + g.members_offset())];
+            for (int64_t i = 0; i < NB; ++i) {
+                float v[64], n = 0.0f;
+                for (auto& x : v) { x = nd(rng); n += x * x; }
+                for (int d = 0; d < 64; ++d) cen[i * D + d] = bf(v[d] / std::sqrt(n));
+                for (int64_t m = 0; m < g.cap; ++m) mem[i * g.cap + m] = (int16_t)(m < g.bucket ? i * g.bucket + m : -1);
+            }
+        }
+        std::vector<int32_t> bt((size_t)blocks);
+        std::iota(bt.begin(), bt.end(), 0);
+        std::vector<float> iq((size_t)D), score((size_t)buckets);
+        float n = 0.0f;
+        for (auto& x : iq) { x = nd(rng); n += x * x; }
+        for (auto& x : iq) x /= std::sqrt(n);
+        std::vector<int32_t> pos = { (int32_t)(ctx - 1) }, cu = { 0, 1 }, sel((size_t)g.width()), nsel(1);
+        std::vector<Opd> t = { opd(iq, RAD_F32, { 1, D }), opd(pos, RAD_I32, { 1 }), opd(cu, RAD_I32, { 2 }),
+                               opd(bkt, RAD_U8, { blocks, 1, g.window, PB / g.window }),
+                               opd(bt, RAD_I32, { 1, blocks }), opd(score, RAD_F32, { 1, buckets }),
+                               opd(sel, RAD_I32, { 1, g.width() }), opd(nsel, RAD_I32, { 1 }) };
+        device_call(lib, st, "r4d_rad_lsa_select", t, geom_params(g), 20, &us);
+        std::printf("bench lsa_select       1 row at %4lldk context  %9.1f us  (%d keys)\n",
+                    (long long)(ctx / 1024), us, nsel[0]);
+    }
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    if (argc < 2) {
+        std::fprintf(stderr, "usage: %s LIB [--bench]\n", argv[0]);
+        return 2;
+    }
+    int n_dev = 0;
+    if (hipGetDeviceCount(&n_dev) != hipSuccess || n_dev < 1) {
+        std::fprintf(stderr, "no card visible\n");
+        return 77;
+    }
+    Lib lib;
+    lib.h = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
+    if (!lib.h) {
+        std::fprintf(stderr, "dlopen %s: %s\n", argv[1], dlerror());
+        return 1;
+    }
+    hipStream_t st;
+    hipcheck(hipStreamCreate(&st), "stream");
+    if (argc > 2 && !std::strcmp(argv[2], "--bench")) {
+        bench(lib, st);
+        return 0;
+    }
+    lsa_cases::Tally tl;
+    const lsa_cases::Backend card = [&](const char* sym, std::vector<lsa_cases::Opd>& t,
+                                        const std::vector<RadParam>& p) {
+        return device_call(lib, st, sym, t, p);
+    };
+    const auto t0 = std::chrono::steady_clock::now();
+    lsa_cases::run_all(card, tl, true);
+    const double s = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    std::printf("lsa_device_test: %d of %d checks passed (%.1f s)\n", tl.cases - tl.failed, tl.cases, s);
+    return tl.failed ? 1 : 0;
+}
