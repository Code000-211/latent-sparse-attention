index 0000000..cbc7b34
--- /dev/null
+++ b/libr4d/r4d_lsa.hip
@@ -0,0 +1,716 @@
+// D-LSA's index side (latent sparse attention: Prefrontal-AI, arXiv 2610.42147, Apache-2.0): the
+// index key store, the closed-block clustering and the decode selection, three ops a full-attention
+// layer issues beside its KV store so that its attention reads sink + top_k + window keys of each
+// query's history instead of all of it (docs/OPS.md, `lsa_*`).
+//
+//   lsa_index_store  every row's index key, normalize(k_free @ W_K), into the `kv_lsa_idx` group (bf16,
+//                    64 a token, paged like the attention's cache), and its index query,
+//                    normalize(sum of the group's queries @ W_Q), into an f32 row.
+//   lsa_cluster      every cluster block (`window` keys) whose last key this step wrote: its index
+//                    keys pooled by `pool` and merged by Ward into window / bucket buckets, written
+//                    as one page of the `kv_lsa_bkt` group, which is paged a block a page.
+//   lsa_select       every query row's read: the buckets of the blocks closed before it scored, the
+//                    `top_p` best expanded best first to `top_k` keys, as an ascending list of
+//                    positions with the sinks and the window, -1 padded, and its length. The paged
+//                    attention over a list (`attn_paged_list`) maps a position to its page itself.
+//
+// The arithmetic is libref/ref_lsa.h's, which states each order it fixes, and that header is held
+// to the paper's torch reference (tests/lsa_ref_test.cpp) and these kernels to it, bit for bit
+// (tests/r4d_emu/test_lsa.cpp on the host emulator, tests/lsa_device_test.cpp on a card). Every
+// dot product is one fmaf chain over the dims in order, from 0; nothing is atomic in an order that
+// could reach a result.
+//
+// Pages. A `kv_lsa_idx` token is one bf16 [64] row: the group is declared at head_dim 32 because
+// the block manager pages a K and a V half, so the operand is [blocks, 1, block, 64]. A
+// `kv_lsa_bkt` page is one closed block's buckets, `window` tokens a page and declared as bytes,
+// [blocks, 1, window, (dim + cap) * 2 / bucket]: centroids [buckets][64] bf16, then members
+// [buckets][cap] int16, block-local positions ascending, -1 past a bucket's size (ref_lsa.h Geom).
+//
+// The select is two launches. One thread scores one bucket against its row's query (the device's
+// whole width on a decode row's 65536 buckets at 512k context), into the f32 `score` plane; then a
+// workgroup a row finds the top_p-th best score by a four-digit radix select, sorts the candidates
+// best first (an equal score to the lower bucket, by a composite key that makes the order unique),
+// cuts the walk at top_k by a prefix count and sorts the expansion into position order.
+//
+// Returns a RAD status rather than throwing, for the reason given in r4d_gemm_fp8a8.hip.
+
+#include "r4d_args.h"
+#include "r4d_common.h"
+#include "r4d_emit.h"
+#include "r4d_launch.h"   // R4D_DYN_LDS
+
+#include <hip/hip_runtime.h>
+#include <climits>
+#include <cmath>
+#include <cstdint>
+
+namespace {
+
+constexpr int kThreads    = 256;
+constexpr int kDim        = 64;     /* index dims: the published maps' width, and the only one here */
+constexpr int kMaxKey     = 1024;   /* key-and-query input dims, n_head_kv * (head_dim - rot) */
+constexpr int kMaxKv      = 16;
+constexpr int kMaxPools   = 128;    /* window / pool: two threads a pool in Ward's search */
+constexpr int kMaxBuckets = 64;     /* window / bucket */
+constexpr int kMaxCap     = 32;
+
+static_assert(kThreads == 2 * kMaxPools, "Ward's search gives each pool two threads");
+
+/* The one dot product (ref_lsa.h `dot`). */
+__device__ __forceinline__ float lsa_dot(const float* a, const float* b) {
+    float acc = 0.0f;
+    for (int d = 0; d < kDim; ++d) acc = fmaf(a[d], b[d], acc);
+    return acc;
+}
+
+/* Exclusive prefix sum of one int a thread over the workgroup, `*total` its sum. `sh` is
+ * kThreads ints of LDS; every thread must call it. */
+__device__ int lsa_excl_scan(int v, int* sh, int* total) {
+    const int t = (int)threadIdx.x;
+    sh[t] = v;
+    __syncthreads();
+    for (int off = 1; off < kThreads; off <<= 1) {
+        const int x = t >= off ? sh[t - off] : 0;
+        __syncthreads();
+        sh[t] += x;
+        __syncthreads();
+    }
+    const int incl = sh[t];
+    *total = sh[kThreads - 1];
+    __syncthreads();
+    return incl - v;
+}
+
+/* Ascending bitonic sort of `n` (a power of two) values in LDS; every thread must call it. */
+template <class T>
+__device__ void lsa_sort(T* s, int n) {
+    for (int k = 2; k <= n; k <<= 1)
+        for (int j = k >> 1; j > 0; j >>= 1) {
+            for (int i = (int)threadIdx.x; i < n; i += kThreads) {
+                const int l = i ^ j;
+                if (l > i) {
+                    const T a = s[i], b = s[l];
+                    if ((i & k) == 0 ? a > b : a < b) { s[i] = b; s[l] = a; }
+                }
+            }
+            __syncthreads();
+        }
+}
+
+__host__ __device__ inline int lsa_pow2(int n) {
+    int p = 1;
+    while (p < n) p <<= 1;
+    return p;
+}
+
+/* A score's order key: the float's total order on 32 bits, both zeros one key, a NaN below
+ * everything. */
+__device__ __forceinline__ uint32_t lsa_okey(float v) {
+    if (v != v) return 0u;
+    const uint32_t bits = v == 0.0f ? 0u : __builtin_bit_cast(uint32_t, v);
+    return (bits & 0x80000000u) ? ~bits : (bits | 0x80000000u);
+}
+
+/* A candidate's sort key, ascending = best first: the score's key high, the bucket inverted low,
+ * so an equal score puts the lower bucket first and no two candidates tie. */
+__device__ __forceinline__ uint64_t lsa_cand(uint32_t key, int b) {
+    return ~(((uint64_t)key << 32) | (uint64_t)(0xffffffffu - (uint32_t)b));
+}
+__device__ __forceinline__ int lsa_cand_bucket(uint64_t c) {
+    return (int)(0xffffffffu - (uint32_t)~c);
+}
+
+/* Which sequence a step row belongs to, from cu_seqlens; -1 for a row past every sequence. */
+__device__ __forceinline__ int lsa_seq_of(const int32_t* cu, int n_seq, int m) {
+    for (int s = 0; s < n_seq; ++s)
+        if (m >= cu[s] && m < cu[s + 1]) return s;
+    return -1;
+}
+
+// ============================================================== lsa_index_store
+
+/* A workgroup a row. The query input sums each group's heads on the position-free dims in head
+ * order and rounds to bf16; the key input is the heads' own. One fmaf chain per (side, key-value
+ * head, index dim) over the head's rows of the map, the heads summed in order, the product rounded
+ * to bf16 and normalized (ref_lsa.h `project`). */
+__global__ __launch_bounds__(kThreads) void lsa_index_store_kernel(
+    const uint16_t* __restrict__ q, long q_ld, const uint16_t* __restrict__ k, long k_ld,
+    const uint16_t* __restrict__ map, const int32_t* __restrict__ slot,
+    uint16_t* __restrict__ cache, long n_slots, float* __restrict__ iq, long iq_ld,
+    int n_head, int n_kv, int head_dim, int rot) {
+    __shared__ float x[2][kMaxKey];
+    __shared__ float part[2][kMaxKv][kDim];
+    __shared__ float y[2][kDim];
+    __shared__ float den[2];
+    const int r = (int)blockIdx.x, t = (int)threadIdx.x;
+    const int free = head_dim - rot, key_dim = n_kv * free, group = n_head / n_kv;
+    const uint16_t* qr = q + (long)r * q_ld;
+    const uint16_t* kr = k + (long)r * k_ld;
+    for (int e = t; e < key_dim; e += kThreads) {
+        const int g = e / free, i = e % free;
+        float s = 0.0f;
+        for (int h = 0; h < group; ++h) s += bf16_to_f32(qr[(g * group + h) * head_dim + rot + i]);
+        x[0][e] = bf16_to_f32(f32_to_bf16(s));
+        x[1][e] = bf16_to_f32(kr[g * head_dim + rot + i]);
+    }
+    __syncthreads();
+    for (int e = t; e < 2 * n_kv * kDim; e += kThreads) {
+        const int side = e / (n_kv * kDim), h = (e / kDim) % n_kv, j = e % kDim;
+        const uint16_t* w = map + (long)side * key_dim * kDim;
+        float acc = 0.0f;
+        for (int i = 0; i < free; ++i) {
+            const int row = h * free + i;
+            acc = fmaf(x[side][row], bf16_to_f32(w[(long)row * kDim + j]), acc);
+        }
+        part[side][h][j] = acc;
+    }
+    __syncthreads();
+    if (t < 2 * kDim) {
+        const int side = t / kDim, j = t % kDim;
+        float total = part[side][0][j];
+        for (int h = 1; h < n_kv; ++h) total += part[side][h][j];
+        y[side][j] = bf16_to_f32(f32_to_bf16(total));
+    }
+    __syncthreads();
+    if (t < 2) {
+        const float n = sqrtf(lsa_dot(y[t], y[t]));
+        den[t] = n > 1e-12f ? n : 1e-12f;   /* x / max(|x|, eps), as F.normalize */
+    }
+    __syncthreads();
+    if (t < kDim) {
+        if (iq) iq[(long)r * iq_ld + t] = y[0][t] / den[0];
+    } else if (t < 2 * kDim) {
+        const int s = slot ? slot[r] : -1;
+        if (s >= 0 && s < n_slots)
+            cache[(long)s * kDim + (t - kDim)] = f32_to_bf16(y[1][t - kDim] / den[1]);
+    }
+}
+
+// ============================================================== lsa_cluster
+
+/* A workgroup a closed block. The grid covers every block any sequence's rows could close (the
+ * step's rows over the window, plus one a sequence); a workgroup finds its (sequence, block) by
+ * walking the sequences and leaves when it has none. A sequence's rows close block b when the
+ * block's last key lies in [first row's position, last row's position + 1), so a rewrite of that
+ * key (a rejected draft replayed) clusters the block again.
+ *
+ * Ward (ref_lsa.h `ward`): each round every live pool finds its cheapest partner under the cap,
+ * two threads a pool over half the others each, an equal cost to the lower partner; every pair
+ * that is each other's cheapest merges into its lower pool, the cheapest `left` of them, an equal
+ * cost to the lower pool. The key sums are recomputed from the keys afterwards, in position order,
+ * as the reference's index_add_ does. */
+__global__ __launch_bounds__(kThreads) void lsa_cluster_kernel(
+    const int32_t* __restrict__ pos, const int32_t* __restrict__ cu, int n_seq,
+    const uint16_t* __restrict__ idx, long idx_pages, int idx_block,
+    const int32_t* __restrict__ idx_bt, long idx_ld, long idx_cols,
+    uint8_t* __restrict__ bkt, long bkt_pages, long page_bytes,
+    const int32_t* __restrict__ bkt_bt, long bkt_ld, long bkt_cols,
+    int window, int pool, int bucket, int cap) {
+    __shared__ float ks[kMaxPools * kDim];   /* the pools' key sums, then the buckets' */
+    __shared__ float sz[kMaxPools], sq[kMaxPools], al[kMaxPools], cost[kMaxPools];
+    __shared__ float hc[kThreads];
+    __shared__ int   hj[kThreads];
+    __shared__ int   best[kMaxPools], parent[kMaxPools], label[kMaxPools], alive[kMaxPools];
+    __shared__ int   mut[kMaxPools];
+    __shared__ int16_t mem[kMaxBuckets * kMaxCap];
+    __shared__ int   msize[kMaxBuckets];
+    __shared__ float den[kMaxBuckets];
+    __shared__ int   job[3];
+    const int t = (int)threadIdx.x;
+    const int P = window / pool, NB = window / bucket;
+
+    if (t == 0) {
+        int g = (int)blockIdx.x, js = -1, jb = 0;
+        for (int s = 0; s < n_seq && js < 0; ++s) {
+            const int r0 = cu[s], r1 = cu[s + 1];
+            if (r1 <= r0 || pos[r0] < 0 || pos[r1 - 1] < 0) continue;
+            const int lo = pos[r0] / window, hi = (pos[r1 - 1] + 1) / window;
+            if (hi <= lo) continue;
+            if (g < hi - lo) { js = s; jb = lo + g; }
+            else g -= hi - lo;
+        }
+        /* Every page the block reads and writes must be in the tables and the pools. */
+        int ok = js >= 0 && jb < bkt_cols && (long)(jb + 1) * window <= idx_cols * idx_block;
+        if (ok) {
+            const int pb = bkt_bt[(long)js * bkt_ld + jb];
+            ok = pb >= 0 && pb < bkt_pages;
+            for (int c = jb * window / idx_block; ok && c < (jb + 1) * window / idx_block; ++c) {
+                const int pi = idx_bt[(long)js * idx_ld + c];
+                ok = pi >= 0 && pi < idx_pages;
+            }
+        }
+        job[0] = ok ? js : -1;
+        job[1] = jb;
+    }
+    __syncthreads();
+    const int s = job[0], b = job[1];
+    if (s < 0) return;
+    const int32_t* row_bt = idx_bt + (long)s * idx_ld;
+    const long first = (long)b * window;
+    auto key_at = [&](int k) -> const uint16_t* {
+        const long at = first + k;
+        return idx + ((long)row_bt[at / idx_block] * idx_block + at % idx_block) * kDim;
+    };
+
+    for (int e = t; e < P * kDim; e += kThreads) {
+        const int p = e / kDim, d = e % kDim;
+        float acc = 0.0f;
+        for (int i = 0; i < pool; ++i) acc += bf16_to_f32(key_at(p * pool + i)[d]);
+        ks[e] = acc;
+    }
+    if (t < P) { sz[t] = (float)pool; alive[t] = 1; parent[t] = t; }
+    __syncthreads();
+
+    for (int round = 0; round < 256; ++round) {
+        int n_alive = 0;
+        for (int i = 0; i < P; ++i) n_alive += alive[i];
+        const int left = n_alive - NB;
+        if (left <= 0) break;
+        if (t < P && alive[t]) {
+            sq[t] = lsa_dot(&ks[t * kDim], &ks[t * kDim]);
+            al[t] = sqrtf(sq[t] > 0.0f ? sq[t] : 0.0f);
+        }
+        __syncthreads();
+        {
+            const int i = t >> 1, span = (P + 1) / 2, j0 = (t & 1) * span;
+            const int j1 = j0 + span < P ? j0 + span : P;
+            float bc = INFINITY;
+            int   bj = 0;
+            if (i < P && alive[i])
+                for (int j = j0; j < j1; ++j) {
+                    if (j == i || !alive[j] || sz[i] + sz[j] > (float)cap) continue;
+                    const float g  = lsa_dot(&ks[i * kDim], &ks[j * kDim]);
+                    const float m2 = (sq[i] + sq[j]) + 2.0f * g;
+                    const float c  = (al[i] + al[j]) - sqrtf(m2 > 0.0f ? m2 : 0.0f);
+                    if (c < bc) { bc = c; bj = j; }
+                }
+            hc[t] = bc;
+            hj[t] = bj;
+        }
+        __syncthreads();
+        if (t < P) {
+            const bool second = hc[2 * t + 1] < hc[2 * t];
+            cost[t] = second ? hc[2 * t + 1] : hc[2 * t];
+            best[t] = second ? hj[2 * t + 1] : hj[2 * t];
+        }
+        __syncthreads();
+        if (t < P) mut[t] = alive[t] && cost[t] < INFINITY && best[best[t]] == t && t < best[t];
+        __syncthreads();
+        int take = 0;
+        if (t < P && mut[t]) {
+            int r = 0;
+            for (int k = 0; k < P; ++k)
+                r += mut[k] && (cost[k] < cost[t] || (cost[k] == cost[t] && k < t));
+            take = r < left;
+        }
+        if (!__syncthreads_or(take)) break;
+        if (take) {
+            const int j = best[t];
+            for (int d = 0; d < kDim; ++d) ks[t * kDim + d] += ks[j * kDim + d];
+            sz[t] += sz[j];
+            alive[j] = 0;
+            parent[j] = t;
+        }
+        __syncthreads();
+    }
+
+    int n_alive = 0;
+    for (int i = 0; i < P; ++i) n_alive += alive[i];
+    /* Ward cannot stop short at cap >= 2 * bucket (the launcher refuses less): the page is not
+     * written rather than written with more buckets than it holds. */
+    if (n_alive != NB) return;
+    if (t < P) {
+        int r = t;
+        while (parent[r] != r) r = parent[r];
+        int n = -1;
+        for (int i = 0; i <= r; ++i) n += alive[i];
+        label[t] = n;
+    }
+    __syncthreads();
+    if (t < NB) {
+        int m = 0;
+        for (int p = 0; p < P; ++p)
+            if (label[p] == t)
+                for (int i = 0; i < pool && m < cap; ++i) mem[t * cap + m++] = (int16_t)(p * pool + i);
+        msize[t] = m;
+        for (; m < cap; ++m) mem[t * cap + m] = -1;
+    }
+    __syncthreads();
+    for (int e = t; e < NB * kDim; e += kThreads) {
+        const int bk = e / kDim, d = e % kDim;
+        float acc = 0.0f;
+        for (int m = 0; m < msize[bk]; ++m) acc += bf16_to_f32(key_at(mem[bk * cap + m])[d]);
+        ks[e] = acc;
+    }
+    __syncthreads();
+    if (t < NB) {
+        const float n = sqrtf(lsa_dot(&ks[t * kDim], &ks[t * kDim]));
+        den[t] = n > 1e-30f ? n : 1e-30f;
+    }
+    __syncthreads();
+    uint8_t* page = bkt + (long)bkt_bt[(long)s * bkt_ld + b] * page_bytes;
+    uint16_t* cen = (uint16_t*)page;
+    for (int e = t; e < NB * kDim; e += kThreads) cen[e] = f32_to_bf16(ks[e] / den[e / kDim]);
+    int16_t* pm = (int16_t*)(page + (long)NB * kDim * 2);
+    for (int e = t; e < NB * cap; e += kThreads) pm[e] = mem[e];
+}
+
+// ============================================================== lsa_select
+
+/* The buckets a row sees: those of the blocks closed before its position, within the table and
+ * the score plane. */
+__device__ __forceinline__ int lsa_visible(int p, int window, int nb, long bt_cols, int live) {
+    long v = p >= 0 ? (long)(p / window) : 0;
+    if (v > bt_cols) v = bt_cols;
+    v *= nb;
+    return (int)(v < live ? v : live);
+}
+
+/* A thread a bucket, a grid row a query row. */
+__global__ __launch_bounds__(kThreads) void lsa_score_kernel(
+    const float* __restrict__ iq, long iq_ld, const int32_t* __restrict__ pos,
+    const int32_t* __restrict__ cu, int n_seq, const uint8_t* __restrict__ bkt, long bkt_pages,
+    long page_bytes, const int32_t* __restrict__ bt, long bt_ld, long bt_cols,
+    float* __restrict__ score, long sc_ld, int live, int window, int nb) {
+    __shared__ float qv[kDim];
+    __shared__ int   info[2];
+    const int m = (int)blockIdx.y, t = (int)threadIdx.x;
+    if (t == 0) {
+        const int s = lsa_seq_of(cu, n_seq, m);
+        info[0] = s;
+        info[1] = s < 0 ? 0 : lsa_visible(pos[m], window, nb, bt_cols, live);
+    }
+    if (t < kDim) qv[t] = iq[(long)m * iq_ld + t];
+    __syncthreads();
+    const int b = (int)blockIdx.x * kThreads + t;
+    if (b >= info[1]) return;
+    const int pg = bt[(long)info[0] * bt_ld + b / nb];
+    float acc = -INFINITY;
+    if (pg >= 0 && pg < bkt_pages) {
+        const uint4* c4 = (const uint4*)(bkt + (long)pg * page_bytes + (long)(b % nb) * kDim * 2);
+        acc = 0.0f;
+        for (int v = 0; v < kDim / 8; ++v) {
+            const uint4 w = c4[v];
+            const uint32_t u[4] = { w.x, w.y, w.z, w.w };
+            for (int h = 0; h < 4; ++h) {
+                acc = fmaf(qv[v * 8 + 2 * h],     bf16_to_f32((uint16_t)(u[h] & 0xffffu)), acc);
+                acc = fmaf(qv[v * 8 + 2 * h + 1], bf16_to_f32((uint16_t)(u[h] >> 16)), acc);
+            }
+        }
+    }
+    score[(long)m * sc_ld + b] = acc;
+}
+
+/* A workgroup a query row: the top_p candidates, best first, walked to top_k keys. */
+__global__ __launch_bounds__(kThreads) void lsa_pick_kernel(
+    const float* __restrict__ score, long sc_ld, int live, const int32_t* __restrict__ pos,
+    const int32_t* __restrict__ cu, int n_seq, const uint8_t* __restrict__ bkt, long bkt_pages,
+    long page_bytes, const int32_t* __restrict__ bt, long bt_ld, long bt_cols,
+    int32_t* __restrict__ sel, long sel_ld, int sel_w, int32_t* __restrict__ nsel,
+    int window, int sink, int top_k, int top_p, int nb, int cap, int cand_n) {
+    R4D_DYN_LDS(uint64_t, dyn);
+    uint64_t* cand = dyn;                         /* [cand_n] candidates, then sorted */
+    int32_t*  cnt  = (int32_t*)(cand + cand_n);   /* [cand_n] keys each reads, then where they go */
+    int32_t*  exp  = cnt + cand_n;                /* [lsa_pow2(top_k)] the expansion */
+    __shared__ int hist[256];
+    __shared__ int scan[kThreads];
+    __shared__ int info[6];
+    const int m = (int)blockIdx.x, t = (int)threadIdx.x;
+    if (t == 0) {
+        const int s = lsa_seq_of(cu, n_seq, m);
+        info[0] = s;
+        info[1] = pos[m];
+        info[2] = s < 0 ? 0 : lsa_visible(pos[m], window, nb, bt_cols, live);
+        info[5] = 0;
+    }
+    __syncthreads();
+    const int s = info[0], p = info[1], n = info[2];
+    int32_t* out = sel + (long)m * sel_ld;
+    if (s < 0 || p < 0) {
+        for (int i = t; i < sel_w; i += kThreads) out[i] = -1;
+        if (t == 0) nsel[m] = 0;
+        return;
+    }
+    const int ws = p + 1 - window > 0 ? p + 1 - window : 0;
+    const float* sc = score + (long)m * sc_ld;
+    const int32_t* row_bt = bt + (long)s * bt_ld;
+
+    /* ---- the candidates: every visible bucket, or the top_p best */
+    int C = n;
+    if (n <= top_p) {
+        for (int b = t; b < n; b += kThreads) cand[b] = lsa_cand(lsa_okey(sc[b]), b);
+    } else {
+        uint32_t prefix = 0, mask = 0;
+        int k_rem = top_p;
+        for (int shift = 24; shift >= 0; shift -= 8) {
+            hist[t] = 0;
+            __syncthreads();
+            for (int b = t; b < n; b += kThreads) {
+                const uint32_t key = lsa_okey(sc[b]);
+                if ((key & mask) == prefix) atomicAdd(&hist[(key >> shift) & 255u], 1);
+            }
+            __syncthreads();
+            if (t == 0) {
+                int above = 0, d = 255;
+                for (; d > 0; --d) {
+                    if (above + hist[d] >= k_rem) break;
+                    above += hist[d];
+                }
+                info[3] = d;
+                info[4] = k_rem - above;
+                info[5] = hist[d];
+            }
+            __syncthreads();
+            prefix |= (uint32_t)info[3] << shift;
+            mask |= 255u << shift;
+            k_rem = info[4];
+            __syncthreads();
+        }
+        /* prefix is the top_p-th best key; k_rem of the keys equal to it are taken, the lowest
+         * buckets, and every key above it. The append order is free: the sort below orders the
+         * candidates by a key no two share. */
+        const uint32_t thr = prefix;
+        const int need_eq = k_rem, all_eq = info[5] == k_rem;
+        if (t == 0) info[3] = 0;
+        __syncthreads();
+        for (int b = t; b < n; b += kThreads) {
+            const uint32_t key = lsa_okey(sc[b]);
+            if (key > thr || (all_eq && key == thr)) cand[atomicAdd(&info[3], 1)] = lsa_cand(key, b);
+        }
+        __syncthreads();
+        if (!all_eq) {
+            int eq_base = 0, c_base = info[3];
+            for (int b0 = 0; b0 < n; b0 += kThreads) {
+                const int b = b0 + t;
+                const int eq = b < n && lsa_okey(sc[b]) == thr;
+                int eq_tot;
+                const int eq_ex = lsa_excl_scan(eq, scan, &eq_tot);
+                const int take = eq && eq_base + eq_ex < need_eq;
+                int tk_tot;
+                const int tk_ex = lsa_excl_scan(take, scan, &tk_tot);
+                if (take) cand[c_base + tk_ex] = lsa_cand(thr, b);
+                eq_base += eq_tot;
+                c_base += tk_tot;
+            }
+        }
+        C = top_p;
+    }
+    const int C2 = lsa_pow2(C > 0 ? C : 1);
+    for (int i = C + t; i < C2; i += kThreads) cand[i] = ~0ull;
+    __syncthreads();
+    lsa_sort(cand, C2);
+
+    /* ---- the keys each candidate reads past the sinks and before the window */
+    auto members = [&](int b, int* blk) -> const int16_t* {
+        *blk = b / nb;
+        const int pg = row_bt[*blk];
+        if (pg < 0 || pg >= bkt_pages) return nullptr;
+        return (const int16_t*)(bkt + (long)pg * page_bytes + (long)nb * kDim * 2) +
+               (long)(b % nb) * cap;
+    };
+    for (int i = t; i < C; i += kThreads) {
+        int blk = 0, c = 0;
+        if (const int16_t* mm = members(lsa_cand_bucket(cand[i]), &blk))
+            for (int k = 0; k < cap && mm[k] >= 0; ++k) {
+                const int at = blk * window + mm[k];
+                c += at >= sink && at < ws;
+            }
+        cnt[i] = c;
+    }
+    __syncthreads();
+    int base = 0;
+    for (int i0 = 0; i0 < C; i0 += kThreads) {
+        const int i = i0 + t;
+        int tot;
+        const int ex = lsa_excl_scan(i < C ? cnt[i] : 0, scan, &tot);
+        if (i < C) cnt[i] = base + ex;
+        base += tot;
+    }
+    const int E = base < top_k ? base : top_k;
+    __syncthreads();
+    for (int i = t; i < C; i += kThreads) {
+        int at0 = cnt[i];
+        if (at0 >= top_k) continue;
+        int blk = 0;
+        if (const int16_t* mm = members(lsa_cand_bucket(cand[i]), &blk))
+            for (int k = 0; k < cap && mm[k] >= 0 && at0 < top_k; ++k) {
+                const int at = blk * window + mm[k];
+                if (at >= sink && at < ws) exp[at0++] = at;
+            }
+    }
+    const int E2 = lsa_pow2(E > 0 ? E : 1);
+    for (int i = E + t; i < E2; i += kThreads) exp[i] = INT_MAX;
+    __syncthreads();
+    lsa_sort(exp, E2);
+
+    /* ---- sinks, expansion, window: one ascending list */
+    const int ns = sink < ws ? sink : ws, total = ns + E + (p - ws + 1);
+    for (int i = t; i < sel_w; i += kThreads)
+        out[i] = i < ns ? i : i < ns + E ? exp[i - ns] : i < total ? ws + (i - ns - E) : -1;
+    if (t == 0) nsel[m] = total;
+}
+
+// ============================================================== plugin ABI entry points
+
+bool lsa_is_table(const RadTensor* t) {
+    return t && t->data && t->dtype == RAD_I32 && t->rank == 2 && t->shape[0] >= 1 &&
+           t->stride[1] == 1 && t->stride[0] >= t->shape[1];
+}
+bool lsa_is_vec(const RadTensor* t, int64_t n) {
+    return t && t->data && t->dtype == RAD_I32 && r4d_numel(t) >= n;
+}
+/* A `kv_lsa_idx` layer: [blocks, 1, block, 64] bf16, packed. */
+bool lsa_is_idx(const RadTensor* t) {
+    return t && t->data && t->dtype == RAD_BF16 && t->rank == 4 && t->shape[1] == 1 &&
+           t->shape[2] >= 1 && t->shape[3] == kDim && r4d_contig(t);
+}
+/* A `kv_lsa_bkt` layer: [blocks, 1, window, page bytes / window] u8, packed. */
+bool lsa_is_bkt(const RadTensor* t, int64_t window, int64_t page_bytes) {
+    return t && t->data && t->dtype == RAD_U8 && t->rank == 4 && t->shape[1] == 1 &&
+           t->shape[2] == window && t->shape[2] * t->shape[3] == page_bytes && r4d_contig(t) &&
+           ((uintptr_t)t->data & 15) == 0;
+}
+
+/* The design's sizes, refused by name where they do not nest or exceed the kernels' LDS. */
+struct LsaSizes {
+    long long window, sink, top_k, top_p, pool, bucket, cap;
+    long long nb() const { return window / bucket; }
+    long long page_bytes() const { return nb() * (kDim + cap) * 2; }
+    /* A cluster block's sizes; the read's besides with `read`. */
+    int ok(bool read) const {
+        if (window < 1 || pool < 1 || bucket < 1 || cap < 1) return 0;
+        if (bucket % pool || window % bucket || cap < 2 * bucket || cap % pool) return 0;
+        if (window / pool > kMaxPools || nb() > kMaxBuckets || cap > kMaxCap) return 0;
+        return !read || (sink >= 0 && top_k >= 1 && top_p >= 1 && top_p * cap >= top_k);
+    }
+};
+LsaSizes lsa_sizes(const RadArgs* a) {
+    return { r4d_geti_or(a, "window", 0), r4d_geti_or(a, "sink", 0), r4d_geti_or(a, "top_k", 0),
+             r4d_geti_or(a, "top_p", 0),  r4d_geti_or(a, "pool", 0), r4d_geti_or(a, "bucket", 0),
+             r4d_geti_or(a, "cap", 0) };
+}
+
+}  // namespace
+
+/* The pick kernel's dynamic LDS: the candidates and their counts at the next power of two of
+ * top_p, the expansion at the next power of two of top_k. */
+static inline size_t lsa_pick_lds(long long top_p, long long top_k) {
+    return (size_t)lsa_pow2((int)top_p) * 12 + (size_t)lsa_pow2((int)top_k) * 4;
+}
+
+enum { LI_Q = 0, LI_K = 1, LI_MAP = 2, LI_SLOT = 3, LI_CACHE = 4, LI_IQ = 5 };
+
+extern "C" int r4d_rad_lsa_index_store(const RadArgs* a, RadStream stream) {
+    const RadTensor *q = r4d_opt(a, LI_Q), *k = r4d_opt(a, LI_K), *mp = r4d_opt(a, LI_MAP);
+    const RadTensor *sl = r4d_opt(a, LI_SLOT), *ca = r4d_opt(a, LI_CACHE), *iq = r4d_opt(a, LI_IQ);
+    const long long hd = r4d_geti_or(a, "head_dim", 0), nh = r4d_geti_or(a, "n_head", 0);
+    const long long nkv = r4d_geti_or(a, "n_head_kv", 0), rot = r4d_geti_or(a, "rot", 0);
+    if (r4d_geti_or(a, "dim", 0) != kDim) return R4D_NO(RAD_E_SHAPE);
+    if (hd < 1 || rot < 0 || rot >= hd || nkv < 1 || nkv > kMaxKv || nh < nkv || nh % nkv ||
+        nkv * (hd - rot) > kMaxKey)
+        return R4D_NO(RAD_E_SHAPE);
+    if (!q || !k || !mp || !q->data || !k->data || !mp->data) return R4D_NO(RAD_E_INVAL);
+    if (q->dtype != RAD_BF16 || k->dtype != RAD_BF16 || mp->dtype != RAD_BF16)
+        return R4D_NO(RAD_E_DTYPE);
+    if (q->rank != 2 || k->rank != 2 || q->shape[0] != k->shape[0] || q->shape[1] < nh * hd ||
+        k->shape[1] < nkv * hd || q->stride[1] != 1 || k->stride[1] != 1)
+        return R4D_NO(RAD_E_SHAPE);
+    const long long T = q->shape[0], key_dim = nkv * (hd - rot);
+    if (r4d_numel(mp) != 2 * key_dim * kDim || !r4d_contig(mp)) return R4D_NO(RAD_E_SHAPE);
+    /* The store is optional (a query-only call), the query too; not both absent. */
+    const bool store = ca && ca->data;
+    if (!store && !(iq && iq->data)) return R4D_NO(RAD_E_INVAL);
+    if (store && (!lsa_is_idx(ca) || !lsa_is_vec(sl, T))) return R4D_NO(RAD_E_SHAPE);
+    if (iq && iq->data &&
+        (iq->dtype != RAD_F32 || iq->rank != 2 || iq->shape[0] < T || iq->shape[1] != kDim ||
+         iq->stride[1] != 1))
+        return R4D_NO(RAD_E_SHAPE);
+    if (T < 1) return RAD_OK;
+    if (T > INT_MAX) return R4D_NO(RAD_E_SHAPE);
+    return R4D_EMIT(stream, lsa_index_store_kernel, dim3((unsigned)T), dim3(kThreads), 0,
+                    (const uint16_t*)q->data, (long)q->stride[0], (const uint16_t*)k->data,
+                    (long)k->stride[0], (const uint16_t*)mp->data,
+                    store ? (const int32_t*)sl->data : nullptr,
+                    store ? (uint16_t*)ca->data : nullptr,
+                    store ? (long)(ca->shape[0] * ca->shape[2]) : 0L,
+                    iq && iq->data ? (float*)iq->data : nullptr,
+                    iq && iq->data ? (long)iq->stride[0] : 0L, (int)nh, (int)nkv, (int)hd,
+                    (int)rot);
+}
+
+enum { LC_POS = 0, LC_CU = 1, LC_IDX = 2, LC_IDX_BT = 3, LC_BKT = 4, LC_BKT_BT = 5 };
+
+extern "C" int r4d_rad_lsa_cluster(const RadArgs* a, RadStream stream) {
+    const LsaSizes z = lsa_sizes(a);
+    if (r4d_geti_or(a, "dim", 0) != kDim || !z.ok(false)) return R4D_NO(RAD_E_SHAPE);
+    const RadTensor *po = r4d_opt(a, LC_POS), *cu = r4d_opt(a, LC_CU), *ix = r4d_opt(a, LC_IDX);
+    const RadTensor *ib = r4d_opt(a, LC_IDX_BT), *bk = r4d_opt(a, LC_BKT);
+    const RadTensor *bb = r4d_opt(a, LC_BKT_BT);
+    if (!po || !po->data || !cu || !cu->data || cu->dtype != RAD_I32 || cu->rank != 1 ||
+        cu->shape[0] < 2)
+        return R4D_NO(RAD_E_INVAL);
+    const long long T = po->shape[0], n_seq = cu->shape[0] - 1;
+    if (!lsa_is_vec(po, T) || !lsa_is_idx(ix) || !lsa_is_table(ib) || !lsa_is_table(bb) ||
+        !lsa_is_bkt(bk, z.window, z.page_bytes()) || ib->shape[0] < n_seq || bb->shape[0] < n_seq)
+        return R4D_NO(RAD_E_SHAPE);
+    if (z.window % ix->shape[2]) return R4D_NO(RAD_E_SHAPE);
+    if (T < 1) return RAD_OK;
+    /* Every block a step could close: its rows over the window, and one a sequence for a run
+     * that straddles a boundary. */
+    const long long grid = T / z.window + n_seq;
+    if (grid > INT_MAX) return R4D_NO(RAD_E_SHAPE);
+    return R4D_EMIT(stream, lsa_cluster_kernel, dim3((unsigned)grid), dim3(kThreads), 0,
+                    (const int32_t*)po->data, (const int32_t*)cu->data, (int)n_seq,
+                    (const uint16_t*)ix->data, (long)ix->shape[0], (int)ix->shape[2],
+                    (const int32_t*)ib->data, (long)ib->stride[0], (long)ib->shape[1],
+                    (uint8_t*)bk->data, (long)bk->shape[0], (long)z.page_bytes(),
+                    (const int32_t*)bb->data, (long)bb->stride[0], (long)bb->shape[1],
+                    (int)z.window, (int)z.pool, (int)z.bucket, (int)z.cap);
+}
+
+enum { LS_IQ = 0, LS_POS = 1, LS_CU = 2, LS_BKT = 3, LS_BT = 4, LS_SCORE = 5, LS_SEL = 6,
+       LS_NSEL = 7 };
+
+extern "C" int r4d_rad_lsa_select(const RadArgs* a, RadStream stream) {
+    const LsaSizes z = lsa_sizes(a);
+    if (r4d_geti_or(a, "dim", 0) != kDim || !z.ok(true)) return R4D_NO(RAD_E_SHAPE);
+    if (lsa_pick_lds(z.top_p, z.top_k) + 4096 > 64 * 1024) return R4D_NO(RAD_E_SHAPE);
