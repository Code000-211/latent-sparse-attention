+/* Tensor parallelism: the layer's KV heads split over `world` ranks, each rank's heads' partial
+ * sums (mode 1) all-reduced on the host in rank order and finished (mode 2), against the whole
+ * row (mode 0). One KV head a rank sums as the one-rank kernel does, so the match is to the bit. */
+inline void index_store_split(const Backend& run, Tally& tl, int64_t T, int64_t n_head, int64_t n_kv,
+                              int64_t hd, int64_t rot, int64_t world, uint64_t seed) {
+    std::mt19937_64 rng(seed);
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    const int64_t D = 64, free = hd - rot, key_dim = n_kv * free, blocks = (T + 15) / 16 + 1;
+    const int64_t hq = n_head / world, hk = n_kv / world;
+    std::vector<uint16_t> q((size_t)(T * n_head * hd)), k((size_t)(T * n_kv * hd)), map((size_t)(2 * key_dim * D));
+    for (auto& x : q) x = bf(nd(rng));
+    for (auto& x : k) x = bf(nd(rng));
+    for (auto& x : map) x = bf(0.05f * nd(rng));
+    std::vector<int32_t> slot((size_t)T);
+    for (int64_t r = 0; r < T; ++r) slot[(size_t)r] = r % 5 == 2 ? -1 : (int32_t)(blocks * 16 - 1 - r);
