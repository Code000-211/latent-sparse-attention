+/* ================================================================== lsa_pages */
+/* Ascending position lists, as lsa_select writes them, over scrambled pages of `bs`. */
+inline void pages(const Backend& run, Tally& tl, int64_t bs, int64_t row0, uint64_t seed) {
+    std::mt19937_64 rng(seed);
+    const int64_t n_seq = 3, cols = 200, W = 97, P = 40, M = 9;
+    std::vector<int32_t> ids((size_t)(n_seq * cols));
+    std::iota(ids.begin(), ids.end(), 0);
+    std::shuffle(ids.begin(), ids.end(), rng);
+    std::vector<int32_t> bt = ids;
+    /* The chunk's M rows are rows [row0, row0 + M) of a step whose sequences split them. */
+    std::vector<int32_t> cu = { 0, (int32_t)(row0 + 3), (int32_t)(row0 + 5), (int32_t)(row0 + M) };
+    std::vector<int32_t> sel((size_t)(M * W), -1), nsel((size_t)M);
+    for (int64_t m = 0; m < M; ++m) {
+        const int64_t pos = 50 + (int64_t)(rng() % (uint64_t)(cols * bs - 60));
+        std::vector<int32_t> l;
+        for (int64_t p = 0; p <= pos && (int64_t)l.size() < W; ++p)
+            if (p < 3 || p > pos - 13 || rng() % 9 == 0) l.push_back((int32_t)p);
+        if (m == 4) l.clear();
+        if (l.empty() || l.back() != pos) { if (!l.empty() && (int64_t)l.size() == W) l.pop_back(); if (m != 4) l.push_back((int32_t)pos); }
+        std::copy(l.begin(), l.end(), sel.begin() + m * W);
+        nsel[(size_t)m] = (int32_t)l.size();
+    }
+    std::vector<int32_t> psel((size_t)(M * P), 0x55555555), pn((size_t)M, -9), sequ((size_t)M, -9);
+    std::vector<int32_t> want((size_t)(M * P), -1), want_n((size_t)M), want_u((size_t)M);
+    for (int64_t m = 0; m < M; ++m) {
+        const int64_t s = m + row0 < cu[1] ? 0 : m + row0 < cu[2] ? 1 : 2;
+        int64_t c = 0, last_blk = -1;
+        for (int64_t i = 0; i < nsel[(size_t)m]; ++i) {
+            const int64_t blk = sel[(size_t)(m * W + i)] / bs;
+            if (blk != last_blk && c < P) want[(size_t)(m * P + c++)] = bt[(size_t)(s * cols + blk)];
+            last_blk = blk;
+        }
+        want_n[(size_t)m] = (int32_t)c;
+        want_u[(size_t)m] = c ? (int32_t)((c - 1) * bs + sel[(size_t)(m * W + nsel[(size_t)m] - 1)] % bs + 1) : 0;
+    }
+    std::vector<Opd> t = { opd(sel, RAD_I32, { M, W }), opd(nsel, RAD_I32, { M }), opd(cu, RAD_I32, { n_seq + 1 }),
+                           opd(bt, RAD_I32, { n_seq, cols }), opd(psel, RAD_I32, { M, P }),
+                           opd(pn, RAD_I32, { M }), opd(sequ, RAD_I32, { M }) };
+    const int rc = run("r4d_rad_lsa_pages", t, { pint("M", M), pint("block_size", bs), pint("row0", row0) }, false);
+    char what[120];
+    std::snprintf(what, sizeof what, "lsa_pages block %lld, row0 %lld", (long long)bs, (long long)row0);
+    tl.check(rc == RAD_OK, std::string(what) + ": status");
+    tl.check(psel == want && pn == want_n && sequ == want_u, std::string(what) + ": the page lists, counts and tokens");
+}
