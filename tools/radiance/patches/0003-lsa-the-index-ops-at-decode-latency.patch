+/* The digit a radix select takes: over `nbins` counts, the bin d (from the top) with fewer than
+ * `k` keys above it and at least `k` from it down. `out` gets d, k less the keys above it, and
+ * d's count. A chunk of bins a thread, then a walk by one thread over the chunks and the chunk's
+ * bins; every thread must call it. */
+template <int NT>
+__device__ void lsa_digit(const int* hist, int nbins, int k, int* sums, int* out) {
+    const int t = (int)threadIdx.x, per = nbins / NT;
+    int s = 0;
+    for (int i = 0; i < per; ++i) s += hist[t * per + i];
+    sums[t] = s;
+    __syncthreads();
+    if (t == 0) {
+        int above = 0, c = NT - 1;
+        for (; c > 0; --c) {
+            if (above + sums[c] >= k) break;
+            above += sums[c];
+        }
+        int d = c * per + per - 1;
+        for (; d > c * per; --d) {
+            if (above + hist[d] >= k) break;
+            above += hist[d];
+        }
+        out[0] = d;
+        out[1] = k - above;
+        out[2] = hist[d];
+    }
+    __syncthreads();
+}
