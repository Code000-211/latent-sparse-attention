+/* ================================================================== the torch reference's fixtures */
+/* tests/mklsagolden.py dump: the design's sizes, the keys and queries beside the reference's
+ * buckets and reads (the reads over its own buckets, centroids in bf16). */
+struct Fixture {
+    rad_lsa::Geom g;
+    int64_t T = 0, Q = 0;
+    std::vector<uint16_t> keys;        /* [T][dim] */
+    std::vector<float>    queries;     /* [Q][dim] */
+    std::vector<int64_t>  positions;   /* [Q] */
+    std::vector<int32_t>  labels;      /* [blocks][pools] */
+    std::vector<float>    centroids;   /* [blocks * buckets][dim] f32 */
+    std::vector<int32_t>  members;     /* [blocks * buckets][cap], absolute, -1 padded */
+    std::vector<int32_t>  sel, lens;   /* [Q][width], [Q] */
+};
+
+inline bool load_fixture(const std::string& path, Fixture* f) {
+    std::ifstream in(path, std::ios::binary);
+    char magic[4];
+    int32_t ver = 0;
+    int64_t h[10];
+    if (!in.read(magic, 4) || std::memcmp(magic, "LSAF", 4) || !in.read((char*)&ver, 4) || ver != 1 ||
+        !in.read((char*)h, sizeof h))
+        return false;
+    rad_lsa::Geom& g = f->g;
+    g.window = h[0]; g.sink = h[1]; g.top_k = h[2]; g.top_p = h[3]; g.pool = h[4];
+    g.bucket = h[5]; g.cap = h[6]; g.dim = h[7];
+    f->T = h[8]; f->Q = h[9];
+    const int64_t D = g.dim, blocks = f->T / g.window, NB = g.buckets();
+    auto rd = [&](auto& v, int64_t n) {
+        v.resize((size_t)n);
+        return (bool)in.read((char*)v.data(), (std::streamsize)(n * sizeof(v[0])));
+    };
+    return rd(f->keys, f->T * D) && rd(f->queries, f->Q * D) && rd(f->positions, f->Q) &&
+           rd(f->labels, blocks * g.pools()) && rd(f->centroids, blocks * NB * D) &&
+           rd(f->members, blocks * NB * g.cap) && rd(f->sel, f->Q * g.width()) && rd(f->lens, f->Q);
+}
+
+/* The kernels against the reference itself, not through ref_lsa.h: lsa_cluster over every block of
+ * the fixture's keys (one sequence's prefill, the pages in order) for the buckets, and lsa_select
+ * over the reference's own buckets for the reads. Counts what differs; `*blocks_bad` and
+ * `*reads_bad` are the blocks whose bucket sets and the reads whose key sets differ. */
+inline bool fixture(const Backend& run, const std::string& path, int64_t* blocks, int64_t* blocks_bad,
+                    int64_t* cen_bad, int64_t* reads, int64_t* reads_bad) {
+    Fixture f;
+    if (!load_fixture(path, &f) || f.g.check()) return false;
+    const rad_lsa::Geom& g = f.g;
+    const int64_t D = g.dim, NB = g.buckets(), PB = g.page_bytes(), nblk = f.T / g.window;
+    /* ---- the clustering */
+    std::vector<uint16_t> idx = f.keys;
+    std::vector<int32_t> ibt((size_t)(f.T / 16)), bbt((size_t)nblk), pos((size_t)f.T), cu = { 0, (int32_t)f.T };
+    std::iota(ibt.begin(), ibt.end(), 0);
+    std::iota(bbt.begin(), bbt.end(), 0);
+    std::iota(pos.begin(), pos.end(), 0);
+    std::vector<uint8_t> bkt((size_t)(nblk * PB), 0);
+    std::vector<Opd> t = { opd(pos, RAD_I32, { f.T }), opd(cu, RAD_I32, { 2 }),
+                           opd(idx, RAD_BF16, { f.T / 16, 1, 16, D }), opd(ibt, RAD_I32, { 1, f.T / 16 }),
+                           opd(bkt, RAD_U8, { nblk, 1, g.window, PB / g.window }), opd(bbt, RAD_I32, { 1, nblk }) };
+    if (run("r4d_rad_lsa_cluster", t, geom_params(g), false) != RAD_OK) return false;
+    *blocks += nblk;
+    for (int64_t b = 0; b < nblk; ++b) {
+        const uint8_t* pg = &bkt[(size_t)(b * PB)];
+        const int16_t* mem = (const int16_t*)(pg + g.members_offset());
+        bool same = true;
+        for (int64_t i = 0; i < NB * g.cap; ++i) {
+            const int32_t want = f.members[(size_t)(b * NB * g.cap + i)];
+            same &= (mem[i] < 0 ? -1 : mem[i] + b * g.window) == want;
+        }
+        *blocks_bad += !same;
+        if (!same) continue;
+        const uint16_t* cen = (const uint16_t*)pg;
+        for (int64_t i = 0; i < NB * D; ++i)
+            *cen_bad += cen[i] != rad_lsa::f32_bf16(f.centroids[(size_t)(b * NB * D + i)]);
+    }
+    /* ---- the reads, over the reference's buckets */
+    for (int64_t b = 0; b < nblk; ++b) {
+        uint8_t* pg = &bkt[(size_t)(b * PB)];
+        uint16_t* cen = (uint16_t*)pg;
+        int16_t* mem = (int16_t*)(pg + g.members_offset());
+        for (int64_t i = 0; i < NB * D; ++i) cen[i] = rad_lsa::f32_bf16(f.centroids[(size_t)(b * NB * D + i)]);
+        for (int64_t i = 0; i < NB * g.cap; ++i) {
+            const int32_t m = f.members[(size_t)(b * NB * g.cap + i)];
+            mem[i] = (int16_t)(m < 0 ? -1 : m - b * g.window);
+        }
+    }
+    const int64_t M = f.Q, W = g.width();
+    std::vector<float> iq = f.queries, score((size_t)(M * nblk * NB));
+    std::vector<int32_t> qpos((size_t)M), qcu = { 0, (int32_t)M }, sel((size_t)(M * W)), nsel((size_t)M);
+    for (int64_t m = 0; m < M; ++m) qpos[(size_t)m] = (int32_t)f.positions[(size_t)m];
+    std::vector<Opd> u = { opd(iq, RAD_F32, { M, D }), opd(qpos, RAD_I32, { M }), opd(qcu, RAD_I32, { 2 }),
+                           opd(bkt, RAD_U8, { nblk, 1, g.window, PB / g.window }), opd(bbt, RAD_I32, { 1, nblk }),
+                           opd(score, RAD_F32, { M, nblk * NB }), opd(sel, RAD_I32, { M, W }), opd(nsel, RAD_I32, { M }) };
+    std::vector<RadParam> p = geom_params(g);
+    p.push_back(pint("M", M));
+    if (run("r4d_rad_lsa_select", u, p, true) != RAD_OK) return false;
+    *reads += M;
+    for (int64_t m = 0; m < M; ++m) {
+        std::vector<int32_t> want(f.sel.begin() + m * W, f.sel.begin() + m * W + f.lens[(size_t)m]);
+        std::sort(want.begin(), want.end());
+        const std::vector<int32_t> got(sel.begin() + m * W, sel.begin() + m * W + nsel[(size_t)m]);
+        *reads_bad += got != want;
+    }
+    return true;
+}
+
